---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SOCIALS } from '../lib/site';
import { PERSON_ID } from '../lib/schema';

const title = 'About Kasra Dash — Entrepreneur and SEO Consultant in Manchester';
const description =
  'Kasra Dash is an entrepreneur and SEO consultant based in Manchester, UK. Founder of The Masterminders conference and creator of mySEO, helping SEOs achieve their goals through tools, education and community.';

const ventures = [
  {
    name: 'The Masterminders',
    tag: 'Premier SEO & Digital Marketing Conference',
    copy: 'Kasra Dash is the founder of The Masterminders Conference, widely regarded as one of the top SEO and digital marketing conferences in the world. Next event: 24-26 June 2026 in Manchester, UK.',
    href: 'https://mastermindersconference.com',
  },
  {
    name: 'mySEO.app',
    tag: 'Free Learning Platform for Verified SEOs',
    copy: 'Kasra Dash is the creator of mySEO.app, a free learning platform, community, and app for verified SEOs, agencies, operators, and suppliers, featuring livestreams, courses, discussions, and real-world SEO education.',
    href: 'https://myseo.app',
  },
  {
    name: 'kasradash.com',
    tag: 'SEO Consulting & 1:1 Strategy',
    copy: 'Kasra Dash runs kasradash.com as his main hub for SEO consulting, 1:1 consultations, content strategy, speaking engagements, and resources.',
    href: '/contact/',
  },
  {
    name: 'Searcharoo',
    tag: 'Link Building & SEO Services',
    copy: 'Kasra Dash is the founder of Searcharoo, a link building and SEO services agency delivering high-quality backlinks and strategies for businesses looking to dominate search.',
    href: 'https://searcharoo.com',
  },
  {
    name: 'FatRank',
    tag: 'Chrome Extension & SEO Tools',
    copy: 'Kasra Dash is the creator of FatRank, a popular Chrome extension that allows users to instantly check keyword rankings, trusted by thousands of SEO professionals worldwide.',
    href: 'https://www.fatrank.com',
  },
  {
    name: 'EEAT-SEO',
    tag: 'E-E-A-T Focused Strategies',
    copy: 'Kasra Dash is the founder of EEAT-SEO, dedicated to helping websites build Experience, Expertise, Authoritativeness, and Trustworthiness through proven SEO methodologies.',
    href: 'https://eeat-seo.com',
  },
];

const expertise = [
  { name: 'SEO & Technical SEO', copy: 'Specialist in search engine optimisation, technical SEO, keyword research, internal linking, content strategy, and topical authority.', href: '/seo/technical-seo/' },
  { name: 'AI-Driven Search', copy: 'An authority on AI-driven search, including AI Overviews and LLM integration, helping brands adapt to the future of search.', href: '/seo/ai-and-seo/' },
  { name: 'Link Building', copy: 'Specialist in link building strategies and backlink acquisition at scale, sharing practical approaches through courses and case studies.', href: '/seo/link-building/' },
  { name: 'E-E-A-T Implementation', copy: 'Recognised authority on E-E-A-T, helping brands build Experience, Expertise, Authoritativeness, and Trustworthiness.', href: '/seo/content-seo/e-e-a-t/' },
  { name: 'Local SEO & Affiliate Marketing', copy: 'Expert in local SEO and affiliate marketing, having helped build and scale affiliate websites valued at over $10M collectively.', href: '/seo/learn/' },
  { name: 'Website Recovery & Growth', copy: 'Consultant specialising in website recovery from Google updates, ROI-focused digital marketing, and sustainable growth.', href: '/seo/technical-seo/google-penalty-recovery/' },
];

const podcasts = [
  { name: 'Rhino Rank Podcast', copy: 'Backlink strategies, sustainable SEO growth, and real-world case studies from affiliate and local SEO campaigns.' },
  { name: 'Affiliate BI', copy: 'Affiliate marketing strategies, traffic growth via internal linking, and zero-to-hero site growth case studies.' },
  { name: 'Adsy Talks', copy: 'Content strategy, topical authority, and practical link building techniques for sustainable organic growth.' },
];

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'About Kasra Dash', href: '/about-kasra-dash/' },
];

// The page's WebPage node is typed AboutPage with mainEntity → the one #person.
const webPageExtras = { mainEntity: { '@id': PERSON_ID } };
---

<BaseLayout {title} {description} path="/about-kasra-dash/" pageType="AboutPage" breadcrumbs={crumbs} {webPageExtras}>
  <main>
    <section class="relative overflow-hidden border-b border-tint-border bg-tint">
      <div class="pointer-events-none absolute -right-32 -top-32 h-80 w-80 rounded-full bg-brand-500/15 blur-3xl" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[1.2fr_0.8fr]">
        <div>
          <Breadcrumbs {crumbs} />
          <p class="mt-4 inline-block rounded-full border border-tint-border bg-tint px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-lavender">Entrepreneur · SEO Expert · Speaker · Educator</p>
          <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">About Kasra Dash</h1>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
            Helping as many SEOs as possible achieve their goals through tools, education, community, and real-world strategies.
          </p>
          <dl class="mt-8 grid max-w-lg grid-cols-3 gap-4">
            <div class="rounded-[20px] border border-tint-border bg-tint p-4 text-center">
              <dd class="font-jakarta text-xl font-bold text-ink sm:text-2xl">$10M+</dd>
              <dt class="mt-1 text-xs text-dim">Affiliate sites scaled</dt>
            </div>
            <div class="rounded-[20px] border border-tint-border bg-tint p-4 text-center">
              <dd class="font-jakarta text-xl font-bold text-ink sm:text-2xl">36.5K+</dd>
              <dt class="mt-1 text-xs text-dim">YouTube subscribers</dt>
            </div>
            <div class="rounded-[20px] border border-tint-border bg-tint p-4 text-center">
              <dd class="font-jakarta text-xl font-bold text-ink sm:text-2xl">Top SEO</dd>
              <dt class="mt-1 text-xs text-dim">Expert 2026</dt>
            </div>
          </dl>
        </div>
        <div class="relative mx-auto w-full max-w-xs lg:max-w-sm">
          <div class="pointer-events-none absolute -inset-6 rounded-full bg-brand-500/15 blur-3xl" aria-hidden="true"></div>
          <img src="/images/image-11-768x783.webp" alt="Kasra Dash" class="relative w-full rounded-[20px] border border-tint-border object-cover" width="384" height="392" />
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <h2 class="font-display text-3xl font-bold tracking-tight text-ink">Who Is Kasra Dash?</h2>
      <div class="prose prose-kasra mt-6 max-w-none">
        <p>
          Kasra Dash is a UK-based entrepreneur, SEO consultant, strategist, speaker, educator, podcaster, and investor. With roots in Scotland and a background in development, Kasra Dash transitioned from building websites to building businesses, becoming one of the most recognised and trusted voices in the SEO industry.
        </p>
        <p>
          Kasra Dash is the founder of The Masterminders Conference, widely regarded as one of the top SEO and digital marketing conferences in the world, with the next event taking place 24-26 June 2026 in Manchester, UK. He is also the creator of mySEO.app, a free learning platform, community, and app for verified SEOs, agencies, operators, and suppliers, featuring livestreams, courses, discussions, and real-world SEO education.
        </p>
        <p>
          Kasra Dash is recognised in 2026 as one of the top SEO experts worldwide, featured in lists such as "Best 26 SEO Experts to Watch in 2026" and "Top SEO Experts to Follow in 2026." He has helped build and scale affiliate websites valued at over $10M collectively, and his journey from developer to industry leader is a testament to his relentless drive to help others succeed through practical, transparent systems.
        </p>
      </div>
    </section>

    <section class="border-y border-tint-border bg-tint py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="font-display text-3xl font-bold tracking-tight text-ink">Mission & Vision</h2>
        <p class="mt-3 max-w-2xl text-muted">
          Kasra Dash's mission is to help as many SEOs as possible achieve their goals. He emphasises practical, real-world, transparent systems and experiments over theory, focusing on sustainable ROI, community building, and helping businesses scale.
        </p>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          <div class="rounded-[20px] border border-tint-border bg-deep p-6">
            <h3 class="font-display text-xl font-bold text-ink">Innovate</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">Build cutting-edge SEO tools through mySEO.app, a free platform featuring livestreams, courses, and real-world SEO education for verified professionals.</p>
          </div>
          <div class="rounded-[20px] border border-tint-border bg-deep p-6">
            <h3 class="font-display text-xl font-bold text-ink">Educate</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">Foster a global community through The Masterminders Conference, YouTube (36.5K+ subscribers), Udemy courses, and published books on advanced SEO topics.</p>
          </div>
          <div class="rounded-[20px] border border-tint-border bg-deep p-6">
            <h3 class="font-display text-xl font-bold text-ink">Empower</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">Equip every SEO professional, from beginner to veteran, with actionable strategies, 1:1 consultations, and the resources they need to achieve measurable results.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="font-display text-3xl font-bold tracking-tight text-ink">Brands & Ventures</h2>
      <p class="mt-3 max-w-2xl text-muted">Every brand Kasra Dash has built is united by one goal: empowering SEO professionals to achieve more.</p>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {ventures.map((v) => (
          <a href={v.href} rel={v.href.startsWith('http') ? 'noopener' : undefined} class="group flex flex-col rounded-[20px] border border-tint-border bg-tint p-6 transition hover:-translate-y-0.5 hover:border-brand-500/50 hover:shadow-lg hover:shadow-brand-500/10">
            <h3 class="font-display text-xl font-bold text-ink transition group-hover:text-brand-600">{v.name}</h3>
            <p class="mt-1 text-xs font-bold uppercase tracking-wider text-brand-600">{v.tag}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{v.copy}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="border-y border-tint-border bg-tint py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="font-display text-3xl font-bold tracking-tight text-ink">Expertise & Experience</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {expertise.map((e) => (
            <div class="rounded-[20px] border border-tint-border bg-deep p-6">
              <h3 class="font-display text-lg font-bold text-ink">
                <a href={e.href} class="hover:text-brand-600">{e.name}</a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{e.copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="font-display text-3xl font-bold tracking-tight text-ink">Podcast Appearances & Citations</h2>
      <p class="mt-3 max-w-2xl text-muted">
        Kasra Dash is a featured guest on leading SEO podcasts and interviews, sharing insights on entity SEO, link building, AI search, and entrepreneurship.
      </p>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {podcasts.map((p) => (
          <div class="rounded-[20px] border border-tint-border bg-tint p-6">
            <h3 class="font-display text-lg font-bold text-ink">{p.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.copy}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-tint-border bg-tint py-16">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="font-display text-3xl font-bold tracking-tight text-ink">Trust & Authority</h2>
        <ul class="mt-6 space-y-4">
          {[
            'Recognised in 2026 as one of the top SEO experts worldwide, featured in lists such as "Best 26 SEO Experts to Watch in 2026" and ranked #1 among top SEO experts to follow.',
            'Acclaimed speaker at major events including Affiliate World Conferences, brightonSEO, and SEO Reborn Summit, and awarded Best SEO Speaker at Search Birmingham.',
            'Founder of The Masterminders Conference and creator of the mySEO.app community for verified SEO professionals.',
            'Featured guest across leading industry podcasts and interviews, including Rhino Rank, Affiliate BI, and Adsy Talks.',
            'Author and educator: published books on advanced SEO topics, Udemy courses on SEO and link building, and 36.5K+ YouTube subscribers.',
            'Angel investor in digital businesses with an IMDb listing for credits related to SEO content and appearances.',
          ].map((item) => (
            <li class="flex gap-3 text-sm leading-relaxed text-ink">
              <span class="brand-gradient mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full text-xs font-bold text-white" aria-hidden="true">✓</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="border-t border-tint-border bg-deep py-16 text-white">
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
        <h2 class="font-display text-3xl font-bold tracking-tight">Connect with Kasra</h2>
        <p class="mx-auto mt-3 max-w-xl text-sm text-lavender/85">
          Follow Kasra Dash across social media for SEO insights, behind-the-scenes content, and updates on mySEO.app and The Masterminders.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          {SOCIALS.map((s) => (
            <a href={s.href} rel="noopener" target="_blank" class="rounded-full border border-tint-border px-4 py-2 text-sm font-semibold text-lavender transition hover:border-brand-500 hover:bg-brand-500/15 hover:text-white">
              {s.label}
            </a>
          ))}
        </div>
        <a href="/contact/" class="btn-gradient mt-8 inline-block px-7 py-3.5 text-base font-bold shadow-lg shadow-brand-500/30 transition hover:shadow-xl hover:shadow-brand-500/40">
          Work With Me
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
