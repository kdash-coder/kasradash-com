---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SERVICES, CASE_STUDIES, MISTAKES, WINS, TESTIMONIALS, FAQS } from '../lib/home-data';
import { PERSON_ID, CANONICAL_DESCRIPTION } from '../lib/schema';

const title = 'Kasra Dash — Entrepreneur and SEO Consultant in Manchester';
const description = CANONICAL_DESCRIPTION;

// NO FAQPage schema (deprecated for commercial sites Aug 2023) — the FAQ section below
// renders as accordions only. Person + WebSite nodes come from Seo.astro's single @graph;
// the home page is the entity home, so its WebPage node points about → #person.
const webPageExtras = { about: { '@id': PERSON_ID } };

const SKOOL_HERO = 'https://www.skool.com/the-new-search/about?utm_source=kasradash.com&utm_medium=site&utm_campaign=home-hero';
const SKOOL_MID = 'https://www.skool.com/the-new-search/about?utm_source=kasradash.com&utm_medium=site&utm_campaign=home-mid-cta';
---

<BaseLayout {title} {description} path="/" {webPageExtras}>
  <main>
    {/* Hero — live pattern: left H1 + gradient CTA + stat counter, portrait right */}
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute right-0 top-1/4 h-96 w-96 rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:py-24">
        <div>
          <p class="inline-block rounded-full border border-tint-border bg-tint px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-lavender">
            Consultant · SEO Expert · Podcaster
          </p>
          <h1 class="mt-5 max-w-xl font-jakarta text-4xl font-bold leading-[1.16] tracking-[-0.6px] text-ink sm:text-5xl lg:text-[3.25rem]">
            Kasra Dash is an entrepreneur and SEO consultant based in Manchester, UK.
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
            Founder of{' '}<a href="https://mastermindersconference.com" rel="noopener" class="font-semibold text-brand-600 hover:text-white hover:underline">The Masterminders Conference</a>, connecting founders, operators, and SEOs worldwide, and creator of{' '}<a href="https://myseo.app" rel="noopener" class="font-semibold text-brand-600 hover:text-white hover:underline">mySEO.app</a>, a learning and community platform for SEOs.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-5">
            <a href={SKOOL_HERO} target="_blank" rel="noopener" class="btn-gradient px-7 py-3.5 text-base font-bold shadow-lg shadow-brand-500/25 transition hover:shadow-xl hover:shadow-brand-500/40">
              Join The New Search
            </a>
            <a href="/about-kasra-dash/" class="text-base font-bold text-ink underline decoration-brand-500/50 decoration-2 underline-offset-4 transition hover:text-brand-600">
              About Kasra Dash
            </a>
          </div>
          <div class="mt-10 rounded-[20px] border border-tint-border bg-tint p-5 sm:max-w-md">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
              <img src="/images/Frame-1261152935.svg" alt="" class="h-9 w-auto" width="181" height="37" loading="lazy" />
              <div>
                <p class="font-jakarta text-3xl font-bold leading-none text-ink">14,700</p>
                <img src="/images/Frame-2147223407.svg" alt="Rated five stars" class="mt-1.5 h-4 w-auto" width="100" height="21" loading="lazy" />
              </div>
            </div>
            <p class="mt-3 text-sm leading-snug text-muted">
              business owners already enjoy higher rankings, more traffic, and lower SEO costs with this proven SEO system.
            </p>
          </div>
        </div>
        <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
          <div class="pointer-events-none absolute -inset-6 rounded-full bg-brand-500/15 blur-3xl" aria-hidden="true"></div>
          <img
            src="/images/kasra-dash.jpg"
            alt="Kasra Dash, entrepreneur and SEO consultant based in Manchester, UK"
            class="relative w-full rounded-[20px] border border-tint-border object-cover"
            width="503"
            height="512"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    {/* As featured in — the five live publication logos, named */}
    <section class="border-y border-tint-border bg-tint py-10" aria-label="As featured in">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <p class="text-center text-xs font-bold uppercase tracking-widest text-dim">As Featured In</p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-x-12 gap-y-6">
          <img src="/images/image-50.svg" alt="Searcharoo" class="h-6 w-auto opacity-75 transition hover:opacity-100 sm:h-7" width="239" height="37" loading="lazy" />
          <img src="/images/image-49-1.svg" alt="Digital Journal" class="h-9 w-auto opacity-75 transition hover:opacity-100 sm:h-10" width="138" height="55" loading="lazy" />
          <img src="/images/image-47.svg" alt="ADVRT" class="h-7 w-auto opacity-75 transition hover:opacity-100 sm:h-8" width="134" height="45" loading="lazy" />
          <img src="/images/image-51.svg" alt="Autoblogging.ai" class="h-7 w-auto opacity-75 transition hover:opacity-100 sm:h-8" width="219" height="47" loading="lazy" />
          <img src="/images/image-52.svg" alt="Backlink Doctor" class="h-8 w-auto opacity-75 transition hover:opacity-100 sm:h-9" width="124" height="47" loading="lazy" />
        </div>
      </div>
    </section>

    {/* Services */}
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="inline-block rounded-full border border-brand-500/30 bg-brand-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-brand-600">Our Services</p>
      <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
        <h2 class="max-w-xl font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Digital Marketing Services</h2>
        <a href="/contact/" class="text-sm font-bold text-brand-600 transition hover:text-white">Discuss your project →</a>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {SERVICES.map((s) => (
          <div class="group rounded-[20px] border border-tint-border bg-tint p-6 transition hover:-translate-y-1 hover:border-brand-500/50 hover:shadow-xl hover:shadow-brand-500/10">
            <h3 class="font-display text-xl font-bold text-ink">
              <a href={s.href} class="transition group-hover:text-brand-600">{s.name}</a>
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{s.copy}</p>
          </div>
        ))}
      </div>
    </section>

    {/* Case studies — live pattern: stat counters + video links */}
    <section class="border-y border-tint-border bg-tint py-20">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <p class="inline-block rounded-full border border-brand-500/30 bg-brand-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-brand-600">Case Studies</p>
        <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Exploring Success Through a Case Study</h2>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {CASE_STUDIES.map((cs) => (
            <div class="flex flex-col rounded-[20px] border border-tint-border bg-deep p-6">
              <p class="inline-block self-start rounded-full bg-brand-500/20 px-3 py-1 text-xs font-bold uppercase tracking-wider text-lavender">{cs.tag}</p>
              <h3 class="mt-4 font-display text-lg font-bold leading-snug text-ink">{cs.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{cs.copy}</p>
              <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-tint-border pt-5">
                {cs.stats.map((st) => (
                  <div>
                    <dd class="font-jakarta text-2xl font-bold text-ink">{st.value}</dd>
                    <dt class="mt-0.5 text-xs text-dim">{st.label}</dt>
                  </div>
                ))}
              </dl>
              <a href={cs.video} rel="noopener" target="_blank" class="mt-6 border-t border-tint-border pt-4 text-sm font-bold text-brand-600 transition hover:text-white">
                Read more →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Wrong vs right */}
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-[20px] border border-tint-border bg-tint p-7">
          <h2 class="font-display text-2xl font-bold text-ink">Where most businesses go wrong with SEO</h2>
          <ul class="mt-5 space-y-3">
            {MISTAKES.map((m) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted">
                <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-red-500/15 text-xs font-bold text-red-400" aria-hidden="true">✕</span>
                {m}
              </li>
            ))}
          </ul>
          <p class="mt-5 border-t border-tint-border pt-4 text-sm leading-relaxed text-dim">
            If this sounds like you, you're missing out on traffic and sales — it's a frustrating place to be, and we've all been there.
          </p>
        </div>
        <div class="rounded-[20px] border border-brand-500/40 bg-deep p-7">
          <h2 class="font-display text-2xl font-bold text-ink">What top-performing websites get right</h2>
          <ul class="mt-5 space-y-3">
            {WINS.map((w) => (
              <li class="flex gap-3 text-sm leading-relaxed text-lavender">
                <span class="brand-gradient mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full text-xs font-bold text-white" aria-hidden="true">✓</span>
                {w}
              </li>
            ))}
          </ul>
          <p class="mt-5 border-t border-tint-border pt-4 text-sm font-semibold leading-relaxed text-muted">
            Again, do not leave money on the table like 95% of businesses do!
          </p>
        </div>
      </div>
      <div class="mt-10 text-center">
        <a href={SKOOL_MID} target="_blank" rel="noopener" class="btn-gradient inline-block px-7 py-3.5 text-base font-bold shadow-lg shadow-brand-500/25 transition hover:shadow-xl hover:shadow-brand-500/40">
          Join The New Search
        </a>
      </div>
    </section>

    {/* Scale up — live band pointing at the video library */}
    <section class="border-y border-tint-border bg-tint">
      <div class="relative mx-auto max-w-6xl overflow-hidden px-4 py-16 sm:px-6">
        <img src="/images/Group-1261152941.svg" alt="" class="pointer-events-none absolute -top-2 right-6 h-28 w-auto opacity-70 sm:h-36" width="79" height="147" loading="lazy" aria-hidden="true" />
        <p class="inline-block rounded-full border border-brand-500/30 bg-brand-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-brand-600">Unlock Your Potential</p>
        <h2 class="mt-3 max-w-xl font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Scale Up Your Marketing</h2>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">
          Elevate your marketing with expert insights and actionable tips. Our videos guide you in expanding your reach and growing your brand effectively in today's competitive landscape.
        </p>
        <a href="https://www.youtube.com/@kasradash" rel="noopener" target="_blank" class="mt-5 inline-block text-sm font-bold text-brand-600 transition hover:text-white">
          Watch on YouTube →
        </a>
      </div>
    </section>

    {/* Testimonials */}
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="inline-block rounded-full border border-brand-500/30 bg-brand-500/10 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-brand-600">Testimonials</p>
      <h2 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">What Our Clients Say</h2>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {TESTIMONIALS.map((t) => (
          <figure class="flex flex-col rounded-[20px] border border-tint-border bg-tint p-6">
            <img src="/images/quote-right-1.svg" alt="" class="h-7 w-7 opacity-60" width="28" height="28" loading="lazy" aria-hidden="true" />
            <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-muted">{t.quote}</blockquote>
            <figcaption class="mt-5 flex items-center gap-3 border-t border-tint-border pt-4 text-sm">
              <img src={t.avatar} alt="" class="h-10 w-10 rounded-full border border-tint-border object-cover" width="40" height="40" loading="lazy" />
              <span>
                <span class="block font-bold text-ink">{t.name}</span>
                <span class="block text-dim">{t.role}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    {/* Community — signups route to The New Search on Skool */}
    <section class="border-y border-tint-border bg-tint py-16">
      <div class="mx-auto max-w-2xl px-4 text-center sm:px-6">
        <h2 class="font-display text-3xl font-bold tracking-tight text-ink">Join The New Search</h2>
        <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted">
          Kasra's AI SEO community on Skool. Weekly live calls, the strategies he is testing right now, and the free AI SEO sheet inside.
        </p>
        <a
          href="https://www.skool.com/the-new-search/about?utm_source=kasradash.com&utm_medium=site&utm_campaign=home-newsletter"
          target="_blank"
          rel="noopener"
          class="btn-gradient mt-6 inline-block px-7 py-3.5 text-base font-bold shadow-lg shadow-brand-500/25 transition hover:shadow-xl hover:shadow-brand-500/40"
        >
          Join The New Search
        </a>
      </div>
    </section>

    {/* FAQ — visual accordion only, deliberately NO FAQPage schema */}
    <section class="border-t border-tint-border bg-tint py-20">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="text-center font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Frequently Asked Questions</h2>
        <div class="mt-10 space-y-3">
          {FAQS.map((f) => (
            <details class="group rounded-[20px] border border-tint-border bg-deep p-5 transition open:border-brand-500/40">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-bold text-ink [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-white/5 text-brand-600 transition group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* Final CTA */}
    <section class="border-t border-tint-border bg-deep py-20">
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
        <h2 class="font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">Ready to Boost Your SEO?</h2>
        <p class="mx-auto mt-4 max-w-xl text-muted">
          Let's chat about your goals and how we can elevate your SEO strategy. Fill out the contact form, and let's start scaling your business together.
        </p>
        <a href="/contact/" class="btn-gradient mt-8 inline-block px-8 py-4 text-base font-bold shadow-lg shadow-brand-500/30 transition hover:shadow-xl hover:shadow-brand-500/40">
          Work With Me
        </a>
        <p class="mt-4 text-sm text-dim">
          Prefer to start smaller? <a href="https://www.skool.com/the-new-search/about?utm_source=kasradash.com&utm_medium=site&utm_campaign=home-cta" target="_blank" rel="noopener" class="font-semibold text-lavender underline transition hover:text-white">Join The New Search, Kasra's AI SEO community</a>.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
