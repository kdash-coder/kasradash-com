---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = 'Contact - Kasra Dash';
const description =
  'Get in touch with Kasra Dash for SEO consulting, 1:1 strategy sessions, speaking engagements, or partnership proposals. Fill in the form and the team will get back to you.';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact/' },
];
---

<BaseLayout {title} {description} path="/contact/" pageType="ContactPage" breadcrumbs={crumbs}>
  <main>
    <section class="border-b border-tint-border bg-tint">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <Breadcrumbs {crumbs} />
        <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">Work With Kasra Dash</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
          Let's chat about your goals and how we can elevate your SEO strategy. Fill out the form below and let's start scaling your business together.
        </p>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1fr_20rem]">
      <div class="overflow-hidden rounded-[20px] border border-tint-border bg-white">
        <iframe
          src="https://api.leadconnectorhq.com/widget/survey/ckXRZUZarDpu3pFaul1E"
          title="Contact Kasra Dash"
          class="h-[720px] w-full"
          loading="lazy"
        ></iframe>
      </div>
      <aside class="space-y-6">
        <div class="rounded-[20px] border border-tint-border bg-tint p-6">
          <h2 class="font-display text-lg font-bold text-ink">What happens next?</h2>
          <ol class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
            <li class="flex gap-3">
              <span class="brand-gradient flex h-6 w-6 flex-none items-center justify-center rounded-full text-xs font-bold text-white">1</span>
              You fill in the form with your goals and current situation.
            </li>
            <li class="flex gap-3">
              <span class="brand-gradient flex h-6 w-6 flex-none items-center justify-center rounded-full text-xs font-bold text-white">2</span>
              Kasra and the team review your website and market.
            </li>
            <li class="flex gap-3">
              <span class="brand-gradient flex h-6 w-6 flex-none items-center justify-center rounded-full text-xs font-bold text-white">3</span>
              You get a clear, honest recommendation on the fastest path to results.
            </li>
          </ol>
        </div>
        <div class="rounded-[20px] border border-tint-border bg-deep p-6 text-white">
          <h2 class="font-display text-lg font-bold">Not ready to talk yet?</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            Start with the free resources: 100+ SEO guides, and The New Search, Kasra's AI SEO community on Skool.
          </p>
          <a href="/seo/" class="mt-4 block rounded-full border border-tint-border px-4 py-2.5 text-center text-sm font-bold text-white transition hover:border-brand-500 hover:bg-brand-500/10">Browse SEO guides</a>
          <a href="https://www.skool.com/the-new-search/about?utm_source=kasradash.com&utm_medium=site&utm_campaign=contact-page" target="_blank" rel="noopener" class="btn-gradient mt-2 block px-4 py-2.5 text-center text-sm font-bold">Join The New Search</a>
        </div>
      </aside>
    </section>
  </main>
</BaseLayout>
