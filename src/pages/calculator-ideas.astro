---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EmailGate from '../components/EmailGate.astro';
import { SITE_URL } from '../lib/site';
import { captureEnabled } from '../lib/capture';

/*
 * Calculator Idea Finder: opt-in tool linked from the "earn links with calculators" YouTube video
 * (Cyrus Shepard's 535-site study). The visitor types their industry; the page shows starting-point
 * calculator and tracker ideas for it, and fills the industry into the Claude/ChatGPT template.
 * The filled template sits behind <EmailGate /> and unlocks in place (copy button).
 *
 * Capture: same universal GoHighLevel webhook as every form on the site (src/lib/capture.ts).
 * source "lm-calculator-ideas", tag "src:lm-calculator-ideas". asset_url is the PDF version of the
 * template, which the universal welcome email links to:
 *   public/downloads/calculator-ideas-template.pdf  (overwrite to update, URL never changes)
 *
 * Description link should carry UTMs, e.g.
 *   /calculator-ideas/?utm_source=youtube&utm_medium=video&utm_campaign=link-earning-tools&utm_content=description
 *
 * The idea patterns are generic patterns with the industry name dropped in. They are labelled as
 * starting points: the template is what does the real research. No made-up data on this page.
 */
const path = '/calculator-ideas/';
const title = 'Calculator Idea Finder: Free Tool Ideas That Earn Links';
const description =
  'Type your industry and get calculator and data-tracker ideas that earn backlinks on their own, plus a free Claude and ChatGPT template that researches the best one for your site.';
const GATE_ID = 'calc-ideas';
const SOURCE = 'lm-calculator-ideas';
const ASSET_NAME = 'The Calculator Idea Finder template';
const ASSET_URL = `${SITE_URL}/downloads/calculator-ideas-template.pdf`;
const SKOOL = 'https://www.skool.com/the-new-search';
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Calculator Idea Finder', href: path },
];
const webPageExtras = captureEnabled
  ? { isAccessibleForFree: false, hasPart: { '@type': 'WebPageElement', isAccessibleForFree: false, cssSelector: `[data-gated="${GATE_ID}"]` } }
  : {};

const quick = ['Plumbing', 'Dentist', 'Family law', 'Estate agent', 'Personal training', 'Wedding venue', 'SEO agency'];

const stats = [
  { n: '1,491', label: 'Data tracking', note: 'linking domains per page, #1' },
  { n: '1,466', label: 'Tools and calculators', note: 'linking domains per page, #2' },
  { n: '28', label: 'Generic articles', note: 'linking domains per page, last' },
];

const template = `You are an SEO and digital PR strategist. My industry is [YOUR INDUSTRY] and my site is [YOUR SITE].

I want to build ONE free tool, calculator or data tracker that other websites, bloggers and journalists will link to on their own, without outreach.

Research my industry on the web, then:

1. List the calculations people in this industry do by hand or in spreadsheets (costs, sizes, timings, quantities, comparisons).
2. List the questions journalists and bloggers in this industry keep asking that have a number as the answer.
3. List data that changes over time that nobody tracks clearly in one place (prices, rates, dates, counts, rankings).
4. Find existing tools for each and note what's weak about them (outdated, ugly, paywalled, not specific enough).

Then give me 10 tool or data-tracker ideas in a table with these columns:
- Tool name
- What it does in one sentence
- Who would link to it, and why
- Where the data comes from (name the actual source and link it)
- How often the data changes
- Existing competitor tools
- Effort to build with AI (low / medium / high)
- Link potential (1-10), with a one-line reason

Score each idea against these five traits, and only rank highly the ones that hit at least four:
original information, helps someone finish a task, shows evidence, specific, long shelf life.

Rules:
- Only use real, public data sources. If you aren't sure a source exists, say so.
- No ideas that need data I'd have to make up.
- No generic "ROI calculator" unless you can make it specific to my industry.
- Finish with your top pick and a simple build plan: the inputs, the outputs, and the data it needs.`;
---

<BaseLayout {title} {description} {path} breadcrumbs={crumbs} {webPageExtras} datePublished="2026-11-27T12:00:00+00:00">
  <main>
    <section class="border-b border-tint-border bg-tint">
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:py-16">
        <Breadcrumbs {crumbs} />
        <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-deep px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-brand-600">Free tool</p>
        <h1 class="mt-4 max-w-3xl font-display text-3xl font-bold leading-tight tracking-tight text-ink sm:text-5xl" style="text-wrap:balance">
          Find the calculator that earns links in your industry
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
          Tools and calculators earn about 50 times more links than a generic blog post. Type your industry and see what you could build.
        </p>

        <form id="ci-form" class="ci-search mt-8" novalidate>
          <label class="sr-only" for="ci-industry">Your industry</label>
          <input id="ci-industry" type="text" maxlength="60" autocomplete="off" placeholder="Your industry, e.g. plumbing" class="ci-input" />
          <button type="submit" class="btn-gradient inline-flex items-center justify-center rounded-full px-7 py-3.5 text-base font-bold text-white">Show me ideas</button>
        </form>
        <div class="mt-4 flex flex-wrap gap-2" aria-label="Examples">
          {quick.map((q) => <button type="button" class="ci-chip" data-q={q}>{q}</button>)}
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-4xl gap-12 px-4 py-12 sm:px-6">
      <div id="ci-results" aria-live="polite">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
          Calculator ideas for <span id="ci-label" class="text-brand-600">your industry</span>
        </h2>
        <p class="mt-2 max-w-2xl text-base leading-relaxed text-muted">
          Starting points, not finished research. The template below checks which ones have real data and real demand in your industry.
        </p>
        <div id="ci-grid" class="mt-6 grid gap-4 sm:grid-cols-2"></div>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        {stats.map((s) => (
          <div class="ci-stat">
            <b>{s.n}</b>
            <span class="font-bold text-ink">{s.label}</span>
            <small>{s.note}</small>
          </div>
        ))}
        <p class="text-xs leading-relaxed text-dim sm:col-span-3">
          Source: Cyrus Shepard,{' '}
          <a href="https://signal.zyppy.com/p/seo-backlinks" class="underline hover:text-muted" rel="noopener" target="_blank">How to Build Backlinks on Autopilot: 535-Site Study</a>,
          Zyppy Signal, 18 Nov 2026. Linking root domains per URL, as published.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">Get the template for your industry</h2>
        <ol class="mt-4 grid gap-2 text-base text-ink">
          <li class="flex gap-3"><span class="ci-step">1</span><span>Copy the template. Your industry is already filled in.</span></li>
          <li class="flex gap-3"><span class="ci-step">2</span><span>Paste it into Claude or ChatGPT with deep research or web search turned on.</span></li>
          <li class="flex gap-3"><span class="ci-step">3</span><span>Check every data source it gives you yourself. AI gets numbers and dates wrong.</span></li>
          <li class="flex gap-3"><span class="ci-step">4</span><span>Pick one idea and build it. Not all ten.</span></li>
        </ol>

        <div class="ci-tpl mt-6" data-gated={captureEnabled ? GATE_ID : undefined} data-gate-teaser>
          <div class="flex items-center justify-between gap-3">
            <p class="font-display text-sm font-bold uppercase tracking-wider text-brand-600">The template</p>
            <button type="button" id="ci-copy" class="btn-gradient inline-flex items-center justify-center rounded-full px-5 py-2 text-sm font-bold text-white">Copy template</button>
          </div>
          <pre id="ci-text" class="mt-4">{template}</pre>
        </div>

        <EmailGate
          gateId={GATE_ID}
          source={SOURCE}
          heading="Unlock the full template"
          blurb="Enter your name and email and the template opens right here, with your industry filled in. I'll email you the PDF version too."
          button="Unlock the template"
          assetName={ASSET_NAME}
          assetUrl={ASSET_URL}
          points={['Ten tool ideas ranked by how likely they are to earn links', 'Where the data comes from for each one', 'A simple build plan for the top pick']}
        />
      </div>

      <div class="ci-cta">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink">Want help building yours?</h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">
          Bring your tool idea to the Wednesday live call inside The New Search. Rank OS comes with the group: the topical map builder shows where the tool fits on your site, and the link building side shows who's worth getting it listed on.
        </p>
        <a href={SKOOL} target="_blank" rel="noopener" class="btn-gradient mt-5 inline-flex items-center justify-center rounded-full px-7 py-3.5 text-base font-bold text-white">Join The New Search <span aria-hidden="true" class="ml-1.5">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .ci-search { display: grid; gap: 0.75rem; max-width: 42rem; }
  @media (min-width: 640px) { .ci-search { grid-template-columns: minmax(0, 1fr) auto; } }
  .ci-input {
    width: 100%; border-radius: 9999px; border: 1px solid rgba(132, 92, 254, 0.45);
    background: #000; color: var(--color-ink); padding: 0.9rem 1.3rem; font-size: 1.05rem;
  }
  .ci-input::placeholder { color: var(--color-dim); }
  .ci-input:focus { outline: 2px solid var(--color-brand-500); outline-offset: 1px; }
  .ci-chip {
    border-radius: 9999px; border: 1px solid var(--color-tint-border); padding: 0.35rem 0.9rem;
    font-size: 0.85rem; font-weight: 700; color: var(--color-muted); cursor: pointer;
  }
  .ci-chip:hover, .ci-chip[aria-pressed='true'] { border-color: #845cfe; color: var(--color-ink); background: rgba(132, 92, 254, 0.15); }
  :global(.ci-card) {
    border-radius: 20px; border: 1px solid var(--color-tint-border); background: var(--color-tint); padding: 1.4rem 1.5rem;
  }
  :global(.ci-card .ci-kind) {
    display: inline-block; border-radius: 9999px; background: #845cfe; color: #fff;
    font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.2rem 0.65rem;
  }
  :global(.ci-card .ci-kind.is-track) { background: #0d9488; }
  :global(.ci-card h3) { margin-top: 0.75rem; font-family: var(--font-display, inherit); font-size: 1.2rem; font-weight: 700; color: var(--color-ink); line-height: 1.25; }
  :global(.ci-card p) { margin-top: 0.5rem; font-size: 0.95rem; line-height: 1.55; color: var(--color-muted); }
  :global(.ci-card dl) { margin-top: 0.8rem; display: grid; gap: 0.35rem; font-size: 0.85rem; color: var(--color-muted); }
  :global(.ci-card dt) { display: inline; font-weight: 700; color: var(--color-ink); }
  :global(.ci-card dd) { display: inline; margin: 0; }
  .ci-stat { border-radius: 20px; border: 1px solid var(--color-tint-border); background: var(--color-tint); padding: 1.3rem 1.4rem; display: grid; gap: 0.2rem; }
  .ci-stat b { font-family: var(--font-display, inherit); font-size: 2.4rem; line-height: 1; font-weight: 800; color: #845cfe; }
  .ci-stat:last-of-type b { color: #f87171; }
  .ci-stat small { font-size: 0.8rem; color: var(--color-dim); }
  .ci-step {
    flex: none; display: inline-flex; height: 1.7rem; width: 1.7rem; align-items: center; justify-content: center;
    border-radius: 9999px; background: #845cfe; color: #fff; font-size: 0.85rem; font-weight: 800;
  }
  .ci-tpl {
    border-radius: 24px; border: 2px solid #845cfe; background: var(--color-tint); padding: 1.5rem;
  }
  .ci-tpl pre {
    white-space: pre-wrap; word-break: break-word; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem; line-height: 1.6; color: var(--color-ink);
  }
  :global(#ci-text mark) { background: rgba(132, 92, 254, 0.35); color: #fff; border-radius: 4px; padding: 0 3px; }
  :global(html.gate-locked-calc-ideas #ci-copy) { display: none; }
  .ci-cta { border-radius: 24px; border: 1px solid var(--color-tint-border); background: var(--color-tint); padding: 2rem; }
</style>

<script>
  type Idea = { kind: 'Calculator' | 'Tracker'; name: string; what: string; who: string; data: string };
  const ideas = (i: string): Idea[] => [
    { kind: 'Calculator', name: `${i} cost calculator`, what: `Answers "how much will this cost me?" from a few inputs: size, location, options.`, who: 'Local news, forums and blogs answering cost questions.', data: 'Your own prices, plus published price surveys.' },
    { kind: 'Tracker', name: `${i} price tracker`, what: 'Shows how prices have moved over time, updated as new figures come out.', who: 'Journalists writing about rising costs.', data: 'Official statistics or public price indexes.' },
    { kind: 'Calculator', name: `How long does it take? (${i})`, what: 'Estimates the timeline for a job or process from the details someone enters.', who: 'Blogs and guides that need a realistic timeframe.', data: 'Your own job records and published averages.' },
    { kind: 'Calculator', name: `${i} "how much do I need" calculator`, what: 'Works out quantities, sizes or amounts so people stop guessing.', who: 'DIY, how-to and comparison sites.', data: 'Standard formulas and manufacturer specs.' },
    { kind: 'Tracker', name: `${i} stats and trends tracker`, what: 'One page with the key numbers for your industry, kept up to date.', who: 'Reporters and bloggers who need one number to quote.', data: 'Government data, trade bodies and public reports.' },
    { kind: 'Calculator', name: `${i} options comparison tool`, what: 'Compares two or three choices side by side on cost, time and results.', who: 'Review and "which is best" articles.', data: 'Published prices and specs for each option.' },
  ];
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

  const input = document.querySelector<HTMLInputElement>('#ci-industry')!;
  const grid = document.querySelector<HTMLElement>('#ci-grid')!;
  const label = document.querySelector<HTMLElement>('#ci-label')!;
  const pre = document.querySelector<HTMLElement>('#ci-text')!;
  const base = pre.textContent ?? '';
  let current = '';

  const fillTemplate = (industry: string) => {
    const ind = industry ? esc(industry.toLowerCase()) : '[YOUR INDUSTRY]';
    pre.innerHTML = esc(base).replace('[YOUR INDUSTRY]', `<mark>${ind}</mark>`).replace('[YOUR SITE]', '<mark>[YOUR SITE]</mark>');
  };

  const render = (raw: string) => {
    const industry = raw.trim().replace(/\s+/g, ' ').slice(0, 60);
    current = industry;
    label.textContent = industry ? industry.toLowerCase() : 'your industry';
    const shown = industry ? cap(industry.toLowerCase()) : 'Your industry';
    grid.innerHTML = ideas(esc(shown))
      .map((d) => `<article class="ci-card"><span class="ci-kind${d.kind === 'Tracker' ? ' is-track' : ''}">${d.kind}</span><h3>${d.name}</h3><p>${d.what}</p><dl><div><dt>Who links: </dt><dd>${d.who}</dd></div><div><dt>Data: </dt><dd>${d.data}</dd></div></dl></article>`)
      .join('');
    fillTemplate(industry);
    document.querySelectorAll<HTMLButtonElement>('.ci-chip').forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.q === industry)));
    try { localStorage.setItem('kd_ci_industry', industry); } catch { /* private mode */ }
  };

  document.querySelector('#ci-form')!.addEventListener('submit', (e) => {
    e.preventDefault();
    render(input.value);
    document.querySelector('#ci-results')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    try { (window as any).gtag?.('event', 'calculator_ideas_search', { industry: current }); } catch { /* optional */ }
  });
  document.querySelectorAll<HTMLButtonElement>('.ci-chip').forEach((c) =>
    c.addEventListener('click', () => { input.value = c.dataset.q ?? ''; render(input.value); })
  );

  document.querySelector<HTMLButtonElement>('#ci-copy')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const gate = document.querySelector<HTMLElement>('#gate-calc-ideas');
    if (gate && document.documentElement.classList.contains('gate-locked-calc-ideas')) {
      gate.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(() => gate.querySelector<HTMLInputElement>('input[name="first_name"]')?.focus({ preventScroll: true }), 600);
      return;
    }
    const text = (pre.textContent ?? '').trim();
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const r = document.createRange(); r.selectNodeContents(pre);
      const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); document.execCommand('copy'); s?.removeAllRanges();
    }
    btn.textContent = 'Copied';
    setTimeout(() => (btn.textContent = 'Copy template'), 2000);
    try { (window as any).gtag?.('event', 'calculator_ideas_copy', { industry: current }); } catch { /* optional */ }
  });

  let saved = '';
  try { saved = localStorage.getItem('kd_ci_industry') ?? ''; } catch { /* private mode */ }
  const q = new URLSearchParams(location.search).get('industry') ?? saved;
  input.value = q;
  render(q);
</script>
