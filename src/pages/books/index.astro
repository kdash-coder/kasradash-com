---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { BOOKS, booksItemListNode, amazonUk } from '../../lib/schema';

const title = 'SEO Books by Kasra Dash';
const description =
  'Kasra Dash is the co-author of three SEO books: The Complete Local SEO Playbook 2025, Advanced SEO Tips 2025 and iGaming SEO, written with James Dooley, Mike Martin, Karl Hudson, Andrew Halliday and Koray Gübür.';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Books', href: '/books/' },
];

const graphNodes = [booksItemListNode()];
const webPageExtras = { mainEntity: { '@id': 'https://kasradash.com/books/#booklist' } };

const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
---

<BaseLayout {title} {description} path="/books/" pageType="CollectionPage" breadcrumbs={crumbs} {graphNodes} {webPageExtras}>
  <main>
    <section class="border-b border-tint-border bg-tint">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
        <Breadcrumbs {crumbs} />
        <h1 class="mt-4 max-w-3xl font-display text-3xl font-bold leading-tight tracking-tight text-ink sm:text-5xl">SEO Books by Kasra Dash</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
          Kasra Dash is the co-author of three SEO books, written with James Dooley and other working SEOs. All three are sold on Amazon in the UK and US.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6" aria-label="The three books">
      <div class="grid gap-5 lg:grid-cols-3">
        {BOOKS.map((book) => (
          <article class="flex flex-col rounded-[20px] border border-tint-border bg-tint p-6">
            <p class="inline-block self-start rounded-full bg-brand-500/20 px-3 py-1 text-xs font-bold uppercase tracking-wider text-lavender">{fmt(book.datePublished)}</p>
            <h2 class="mt-4 font-display text-xl font-bold leading-snug text-ink">
              <a href={`/books/${book.slug}/`} class="transition hover:text-brand-600">{book.name}</a>
            </h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{book.subtitle}</p>
            <p class="mt-4 text-xs text-dim">By {book.authorNames.join(', ')}</p>
            <div class="mt-5 flex flex-wrap gap-2 border-t border-tint-border pt-5">
              <a href={`/books/${book.slug}/`} class="btn-gradient px-4 py-2 text-xs font-bold">About the book</a>
              <a href={amazonUk(book)} target="_blank" rel="noopener" class="rounded-full border border-tint-border px-4 py-2 text-xs font-bold text-ink transition hover:border-brand-500 hover:bg-brand-500/10">Buy on Amazon UK</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="border-t border-tint-border bg-tint py-14">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">Who does Kasra Dash write with?</h2>
        <p class="mt-4 leading-relaxed text-muted">
          All three books are collaborations. James Dooley, Kasra's mentor since 2019, co-authored every title;
          Mike Martin joined for the local SEO playbook, and Karl Hudson, Andrew Halliday and Koray Gübür
          co-wrote the advanced and iGaming titles. Several of the co-authors have also appeared on
          <a href="/podcast/" class="font-semibold text-brand-600 transition hover:text-white"> The Business Dash With Kasra</a>.
        </p>
        <p class="mt-4 leading-relaxed text-muted">
          For the story behind the books, read <a href="/about-kasra-dash/" class="font-semibold text-brand-600 transition hover:text-white">about Kasra Dash</a> or see his
          <a href="/partnerships/" class="font-semibold text-brand-600 transition hover:text-white"> partnerships</a>.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
