---
import BookPage from '../../components/BookPage.astro';
import { BOOKS } from '../../lib/schema';

const book = BOOKS.find((b) => b.slug === 'advanced-seo-tips')!;

const title = 'Advanced SEO Tips 2025: The Future of Search — Book by Kasra Dash';
const description =
  'Kasra Dash is the author of Advanced SEO Tips 2025: The Future of Search, a 476-page book on where search is heading.';

const coverage = [
  'Advanced SEO Tips 2025: The Future of Search is a 476-page book about where search is heading, written by James Dooley, Kasra Dash, Karl Hudson, Andrew Halliday and Koray Gübür.',
  'The book does what its subtitle says: it busts common SEO myths and sets out the strategies its five authors run on their own sites and for clients.',
  'Advanced SEO Tips 2025 covers the shift towards AI-driven search and the practices the authors expect to survive it. The Kindle edition was published on 13 April 2025.',
  'The book is one of the three SEO books Kasra Dash has written, alongside The Complete Local SEO Playbook 2025 and iGaming SEO.',
];

const authorNotes = {
  'James Dooley': "James Dooley is an SEO entrepreneur and Kasra Dash's mentor since 2019; he wrote all three books with Kasra.",
  'Kasra Dash': 'Kasra Dash is an entrepreneur and SEO consultant based in Manchester, UK. He is the founder of The Masterminders conference and creator of mySEO.',
  'Karl Hudson': 'Karl Hudson wrote two of the three books in the series and has appeared on The Business Dash With Kasra.',
  'Andrew Halliday': 'Andrew Halliday is one of the five co-authors of Advanced SEO Tips 2025.',
  'Koray Gübür': 'Koray Gübür wrote two of the three books in the series and has appeared on The Business Dash With Kasra.',
};
---

<BookPage {book} {title} {description} {coverage} {authorNotes} />
