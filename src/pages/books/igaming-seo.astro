---
import BookPage from '../../components/BookPage.astro';
import { BOOKS } from '../../lib/schema';

const book = BOOKS.find((b) => b.slug === 'igaming-seo')!;

const title = 'iGaming SEO — Book by Kasra Dash';
const description =
  'Kasra Dash is the author of iGaming SEO, a book on advanced SEO for online gambling covering casinos, slots, bingo and sports betting.';

const coverage = [
  'iGaming SEO: The Truth About Advanced SEO for Online Gambling is a book about search strategy in the gambling verticals: casinos, slots, bingo and sports betting. It was written by James Dooley, Karl Hudson, Kasra Dash and Koray Gübür.',
  'The book explains what changes when a niche is this competitive: how link building, content and technical decisions differ from mainstream SEO, and which shortcuts get sites penalised.',
  "iGaming SEO draws on the authors' direct experience ranking gambling and affiliate sites. The Kindle edition was published on 11 April 2025.",
  'iGaming SEO completes the series of three SEO books Kasra Dash has written, alongside The Complete Local SEO Playbook 2025 and Advanced SEO Tips 2025.',
];

const authorNotes = {
  'James Dooley': "James Dooley is an SEO entrepreneur and Kasra Dash's mentor since 2019; he wrote all three books with Kasra.",
  'Karl Hudson': 'Karl Hudson wrote two of the three books in the series and has appeared on The Business Dash With Kasra.',
  'Kasra Dash': 'Kasra Dash is an entrepreneur and SEO consultant based in Manchester, UK. He has worked on gambling and affiliate SEO campaigns referenced in his case studies.',
  'Koray Gübür': 'Koray Gübür wrote two of the three books in the series and has appeared on The Business Dash With Kasra.',
};
---

<BookPage {book} {title} {description} {coverage} {authorNotes} />
