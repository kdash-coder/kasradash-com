---
import BookPage from '../../components/BookPage.astro';
import { BOOKS } from '../../lib/schema';

const book = BOOKS.find((b) => b.slug === 'the-complete-local-seo-playbook')!;

const title = 'The Complete Local SEO Playbook 2025 — Book by Kasra Dash';
const description =
  'Kasra Dash is the author of The Complete Local SEO Playbook 2025, a 179-page guide to local rankings, Google Business Profile optimisation and link building.';

const coverage = [
  'The Complete Local SEO Playbook 2025 is a 179-page guide to ranking a business in local search, written by Mike Martin, James Dooley and Kasra Dash.',
  'The book covers the three disciplines its subtitle names: boosting local rankings, optimising a Google Business Profile, and building the links that local results reward. Each is treated as a repeatable process rather than theory.',
  'The Complete Local SEO Playbook 2025 was published independently on 15 November 2024 and is written for business owners and SEOs who want a local process they can run again and again.',
  'The playbook is the first of the three SEO books Kasra Dash has written, alongside Advanced SEO Tips 2025 and iGaming SEO.',
];

const authorNotes = {
  'Mike Martin': 'Mike Martin wrote The Complete Local SEO Playbook 2025 with Kasra Dash and James Dooley, and hosts the Mike Martin Asks podcast, where Kasra appeared in June 2023.',
  'James Dooley': "James Dooley is an SEO entrepreneur and Kasra Dash's mentor since 2019; he wrote all three books with Kasra.",
  'Kasra Dash': 'Kasra Dash is an entrepreneur and SEO consultant based in Manchester, UK. He is the founder of The Masterminders conference and creator of mySEO.',
};
---

<BookPage {book} {title} {description} {coverage} {authorNotes} />
