---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = 'Speaking — Kasra Dash';
const description =
  'Kasra Dash speaks at SEO and marketing events including brightonSEO and WOSCon, and hosts The Masterminders conference in Manchester, running 24 to 26 June 2026 at the Hilton Deansgate.';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Speaking', href: '/speaking/' },
];

const engagements = [
  {
    name: 'Host of The Masterminders',
    when: '24–26 June 2026 · Hilton Deansgate, Manchester',
    copy: 'Kasra founded and hosts The Masterminders, a conference that brings business owners and SEO professionals together in Manchester. The 2026 edition runs over three days in June.',
    href: 'https://themasterminders.com/',
    linkLabel: 'Visit themasterminders.com →',
  },
  {
    name: 'brightonSEO',
    when: 'September 2023 · Brighton',
    copy: 'Kasra spoke at brightonSEO, the search marketing conference, in September 2023. His speaker profile covers website recovery and SEO consulting.',
    href: 'https://brightonseo.com/people/kasra-dash',
    linkLabel: 'View his brightonSEO profile →',
  },
  {
    name: 'WOSCon 2024',
    when: '2024',
    copy: 'Kasra appeared in the WOSCon 2024 live interview series, talking through his approach to SEO on camera.',
    href: 'https://www.youtube.com/watch?v=FfkRa228qs8',
    linkLabel: 'Watch the interview →',
  },
  {
    name: 'SEO Estonia 2024',
    when: '2024 · Tallinn, Estonia',
    copy: "Kasra Dash spoke at SEO Estonia in 2024, returning after his 2023 appearance. The conference's own speaker archive lists him in the 2024 lineup.",
    href: 'https://seoestonia.com/',
    linkLabel: 'Visit seoestonia.com →',
    lineup: {
      intro: 'The SEO Estonia 2024 lineup included',
      names: [{ name: 'Jason Barnard', href: 'https://jasonbarnard.com/' }],
    },
  },
  {
    name: 'SEO Estonia 2023',
    when: '2023 · Tallinn, Estonia',
    copy: "Kasra Dash spoke at SEO Estonia in 2023. The conference's speaker archive lists him in the 2023 lineup, and its site carries his 2023 feedback video.",
    href: 'https://seoestonia.com/',
    linkLabel: 'Visit seoestonia.com →',
    lineup: {
      intro: 'The SEO Estonia 2023 lineup included',
      names: [
        { name: 'Charles Floate', href: 'https://charlesfloate.com/' },
        { name: 'Kyle Roof' },
      ],
    },
  },
  {
    name: 'Chiang Mai SEO 2023',
    when: '2023 · Chiang Mai, Thailand',
    copy: 'Kasra Dash spoke at Chiang Mai SEO 2023, the SEO conference held in Chiang Mai, Thailand.',
    href: 'https://chiangmaiseoconference.com/',
    linkLabel: 'Visit chiangmaiseoconference.com →',
    lineup: {
      intro: 'Kasra Dash spoke alongside',
      names: [
        { name: 'Kevin Indig', href: 'https://www.kevin-indig.com/' },
        { name: 'Koray Tuğberk Gübür', href: 'https://www.holisticseo.digital/' },
        { name: 'Kyle Roof' },
        { name: 'Matt Diggity', href: 'https://diggitymarketing.com/' },
        { name: 'Tim Soulo', href: 'https://timsoulo.com/' },
        { name: 'Craig Campbell', href: 'https://www.craigcampbellseo.com/' },
      ],
    },
  },
  {
    name: 'SEO Mastery Summit',
    when: 'Ho Chi Minh City, Vietnam',
    copy: 'Kasra Dash spoke at the SEO Mastery Summit, the SEO and AI conference held in Ho Chi Minh City.',
    href: 'https://seomasterysummit.com/',
    linkLabel: 'Visit seomasterysummit.com →',
  },
  {
    name: 'Affiliate World 2024',
    when: '2024',
    copy: 'Kasra Dash spoke at Affiliate World 2024, the affiliate marketing conference series.',
    lineup: {
      intro: 'Kasra Dash spoke at Affiliate World 2024 alongside',
      names: [
        { name: 'Craig Campbell', href: 'https://www.craigcampbellseo.com/' },
        { name: 'Carrie Rose' },
        { name: 'Dennis Yu', href: 'https://dennisyu.com/' },
      ],
    },
  },
];

/* Lineup verification ledger (11 Aug 2026): every linked name's own site was loaded
 * live and identity-confirmed. Kyle Roof plain text (kyleroof.com TLS cert expired;
 * spelling confirmed via the SEO Estonia speaker archive). Carrie Rose plain text
 * (riseatseven.com confirms "Carrie" but no personal entity home verified).
 * OMITTED pending Kasra's confirmation: "Van Oakes" (site unreachable, spelling
 * unverifiable) and "Karl Kangur" for Estonia 2023 (the event archive lists him
 * for 2026, not 2023 — likely a voice-transcription mishear of Kalin Karakehayov). */

/* Photo slot per engagement: Kasra is supplying event photos. Add
 * image: { src: '/images/speaking/<file>', alt: '<entity-first alt>' }
 * to any entry above and the card renders it; nothing renders until then. */

// Event nodes — attested engagements; url only where the event site verified live (11 Aug 2026).
const eventNodes = [
  {
    '@type': 'Event',
    name: 'The Masterminders 2026',
    startDate: '2026-06-24',
    endDate: '2026-06-26',
    location: { '@type': 'Place', name: 'Hilton Deansgate', address: { '@type': 'PostalAddress', addressLocality: 'Manchester', addressCountry: 'United Kingdom' } },
    organizer: { '@id': 'https://kasradash.com/#person' },
    url: 'https://themasterminders.com/',
  },
  {
    '@type': 'Event',
    name: 'brightonSEO September 2023',
    startDate: '2023-09',
    location: { '@type': 'Place', name: 'Brighton', address: { '@type': 'PostalAddress', addressLocality: 'Brighton', addressCountry: 'United Kingdom' } },
    performer: { '@id': 'https://kasradash.com/#person' },
    url: 'https://brightonseo.com/people/kasra-dash',
  },
  {
    '@type': 'Event',
    name: 'SEO Estonia 2023',
    startDate: '2023',
    location: { '@type': 'Place', name: 'Tallinn', address: { '@type': 'PostalAddress', addressLocality: 'Tallinn', addressCountry: 'Estonia' } },
    performer: { '@id': 'https://kasradash.com/#person' },
    url: 'https://seoestonia.com/',
  },
  {
    '@type': 'Event',
    name: 'SEO Estonia 2024',
    startDate: '2024',
    location: { '@type': 'Place', name: 'Tallinn', address: { '@type': 'PostalAddress', addressLocality: 'Tallinn', addressCountry: 'Estonia' } },
    performer: { '@id': 'https://kasradash.com/#person' },
    url: 'https://seoestonia.com/',
  },
  {
    '@type': 'Event',
    name: 'Chiang Mai SEO 2023',
    startDate: '2023',
    location: { '@type': 'Place', name: 'Chiang Mai', address: { '@type': 'PostalAddress', addressLocality: 'Chiang Mai', addressCountry: 'Thailand' } },
    performer: { '@id': 'https://kasradash.com/#person' },
    url: 'https://chiangmaiseoconference.com/',
  },
  {
    '@type': 'Event',
    name: 'SEO Mastery Summit',
    location: { '@type': 'Place', name: 'Ho Chi Minh City', address: { '@type': 'PostalAddress', addressLocality: 'Ho Chi Minh City', addressCountry: 'Vietnam' } },
    performer: { '@id': 'https://kasradash.com/#person' },
    url: 'https://seomasterysummit.com/',
  },
  {
    '@type': 'Event',
    name: 'Affiliate World 2024',
    startDate: '2024',
    performer: { '@id': 'https://kasradash.com/#person' },
  },
  {
    '@type': 'Event',
    name: 'WOSCon 2024',
    startDate: '2024',
    performer: { '@id': 'https://kasradash.com/#person' },
    url: 'https://www.youtube.com/watch?v=FfkRa228qs8',
  },
];
---

<BaseLayout {title} {description} path="/speaking/" breadcrumbs={crumbs} graphNodes={eventNodes}>
  <main>
    <section class="border-b border-tint-border bg-tint">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
        <Breadcrumbs {crumbs} />
        <h1 class="mt-4 max-w-3xl font-display text-3xl font-bold leading-tight tracking-tight text-ink sm:text-5xl">Speaking</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
          Kasra Dash is an entrepreneur and SEO consultant based in Manchester, UK. He has spoken at SEO conferences across Europe and Asia and hosts his own conference in Manchester.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6" aria-label="Speaking engagements">
      <div class="space-y-4">
        {engagements.map((e) => (
          <article class="rounded-[20px] border border-tint-border bg-tint p-6">
            {e.image && (
              <img src={e.image.src} alt={e.image.alt} class="mb-5 w-full rounded-xl border border-tint-border object-cover" loading="lazy" />
            )}
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 class="font-display text-lg font-bold text-ink">{e.name}</h2>
              <p class="text-xs font-semibold uppercase tracking-wider text-dim">{e.when}</p>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-muted">{e.copy}</p>
            {e.lineup && (
              <p class="mt-3 text-sm leading-relaxed text-dim">
                {e.lineup.intro}{' '}
                {e.lineup.names.map((person, i) => (
                  <>
                    {i > 0 && (i === e.lineup.names.length - 1 ? ' and ' : ', ')}
                    {person.href ? (
                      <a href={person.href} target="_blank" rel="noopener" class="font-semibold text-lavender transition hover:text-white">{person.name}</a>
                    ) : (
                      <span class="font-semibold text-lavender">{person.name}</span>
                    )}
                  </>
                ))}.
              </p>
            )}
            {e.href && (
              <a href={e.href} target="_blank" rel="noopener" class="mt-4 inline-block text-sm font-bold text-brand-600 transition hover:text-white">
                {e.linkLabel}
              </a>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="border-t border-tint-border bg-tint py-14">
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
        <h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">Book Kasra to speak</h2>
        <p class="mx-auto mt-3 max-w-xl text-muted">
          For conference talks, panels or podcast interviews, email me@kasradash.com or use the contact form.
        </p>
        <a href="/contact/" class="btn-gradient mt-6 inline-block px-6 py-3 text-sm font-bold shadow-lg shadow-brand-500/25 transition hover:shadow-xl hover:shadow-brand-500/40">
          Contact Kasra
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
