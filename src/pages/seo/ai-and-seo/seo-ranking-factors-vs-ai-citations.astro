  </div>
</BaseLayout>

<style>
  .chip {
    border-radius: 50px;
    border: 1px solid var(--color-tint-border);
    padding: 0.375rem 0.875rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-muted);
    transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
  }
  .chip:hover {
    border-color: rgb(255 255 255 / 0.3);
    color: var(--color-ink);
  }
  .chip.is-active {
    border-color: rgb(132 92 254 / 0.6);
    background-color: rgb(132 92 254 / 0.15);
    color: var(--color-brand-600);
  }
  .example-text :global(.hl-seo) { color: #b7a3ff; background: rgb(132 92 254 / 0.16); border-radius: 4px; padding: 0 0.3em; }
  .example-text :global(.hl-ai) { color: #5eead4; background: rgb(45 212 191 / 0.14); border-radius: 4px; padding: 0 0.3em; }
  .example-text :global(.hl-sub) { color: #b7a3ff; background: rgb(132 92 254 / 0.18); border-radius: 4px; padding: 0.05em 0.3em; }
  .example-text :global(.hl-pred) { color: #5eead4; background: rgb(45 212 191 / 0.16); border-radius: 4px; padding: 0.05em 0.3em; }
  .example-text :global(.hl-obj) { color: #fbbf24; background: rgb(251 191 36 / 0.14); border-radius: 4px; padding: 0.05em 0.3em; }
  .example-text :global(.hl-bad) { color: #fca5a5; background: rgb(248 113 113 / 0.14); border-radius: 4px; padding: 0 0.3em; }
  .example-text :global(.hl-good) { color: #86efac; background: rgb(74 222 128 / 0.14); border-radius: 4px; padding: 0 0.3em; }
  .example-text :global(code) { font-size: 0.85em; color: var(--color-lavender); }
  #skool-bar {
    transform: translateY(100%);
    transition: transform 300ms ease-out;
  }
  #skool-bar.is-visible {
    transform: translateY(0);
  }
  body.has-skool-bar {
    padding-bottom: 4.5rem;
  }
  [id].scroll-mt-28:target {
    border-color: rgb(132 92 254 / 0.7);
    box-shadow: 0 0 0 4px rgb(132 92 254 / 0.15);
  }
  .factor-row[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .bar {
      transform-origin: left;
      animation: grow 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes grow {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }
  }
</style>

<script>
  const bar = document.getElementById('skool-bar');
  const closeBtn = document.getElementById('skool-bar-close');
  if (bar && closeBtn) {
    let dismissed = false;
    try {
      dismissed = sessionStorage.getItem('skool-bar-dismissed') === '1';
    } catch {}
    const threshold = 500;
    const update = () => {
      const show = !dismissed && window.scrollY > threshold;
      bar.classList.toggle('is-visible', show);
      document.body.classList.toggle('has-skool-bar', show);
    };
    if (!dismissed) {
      window.addEventListener('scroll', update, { passive: true });
      update();
    }
    closeBtn.addEventListener('click', () => {
      dismissed = true;
      try {
        sessionStorage.setItem('skool-bar-dismissed', '1');
      } catch {}
      update();
    });
  }

  const list = document.getElementById('factor-chart');
  if (list) {
    const rows = Array.from(list.querySelectorAll<HTMLLIElement>('.factor-row'));
    for (const row of rows) {
      row.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        const target = document.getElementById(row.dataset.target ?? '');
        if (!target) return;
        history.pushState(null, '', `#${row.dataset.target}`);
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
    let sort = 'gap';
    let filter = 'all';

    const num = (el: HTMLElement, key: string) => Number(el.dataset[key] ?? 0);

    function apply() {
      const sortedRows = [...rows].sort((a, b) => num(b, sort) - num(a, sort));
      for (const row of sortedRows) {
        const leader = row.dataset.leader;
        row.hidden = filter !== 'all' && leader !== filter;
        list!.appendChild(row);
      }
    }

    function activate(group: string, value: string) {
      document.querySelectorAll<HTMLButtonElement>(`[data-${group}]`).forEach((b) => {
        const on = b.dataset[group] === value;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
      });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((b) =>
      b.addEventListener('click', () => {
        sort = b.dataset.sort!;
        activate('sort', sort);
        apply();
      })
    );
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) =>
      b.addEventListener('click', () => {
        filter = b.dataset.filter!;
        activate('filter', filter);
        apply();
      })
    );
  }
</script>
