                <span class="rounded-full border border-brand-500/40 bg-brand-500/15 px-2.5 py-0.5 text-brand-600">SEO {f.seo}</span>
                <span class="rounded-full border border-[#2dd4bf]/40 bg-[#2dd4bf]/10 px-2.5 py-0.5 text-[#5eead4]">AI {f.ai}</span>
              </div>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted sm:text-base">{f.why}</p>
            {examples[f.id] && (
              <div class="mt-5 rounded-[14px] border border-tint-border bg-black/60 p-4 sm:p-5">
                <p class="font-display text-[0.65rem] font-bold uppercase tracking-wider text-dim">Example</p>
