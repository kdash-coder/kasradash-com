---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { SITE_URL } from '../../../lib/site';
import { articleNode } from '../../../lib/schema';

/*
 * SEO ranking factors vs AI citation factors: the side-by-side weighting page.
 * Scores are Kasra Dash's practitioner weightings (0 to 100, relative weight of
 * each signal within its own system), not measured percentages. Keep the
 * `factors` array as the single source of truth: the chart, the summary cards
 * and the per-factor breakdown all render from it.
 */

const path = '/seo/ai-and-seo/seo-ranking-factors-vs-ai-citations/';
const h1 = 'SEO Ranking Factors vs AI Citation Factors: What Moves Each One';
const title = 'SEO Ranking Factors vs AI Citation Factors (Side by Side)';
const description =
  'SEO ranking factors vs AI citation factors, weighted 0 to 100 side by side. See why links move Google, why context moves ChatGPT, and where the two split.';
const ogImage = '/images/kasradash.com_.png';
const datePublished = '2026-09-09T12:00:00+00:00';
const dateModified = '2026-09-09T12:00:00+00:00';

const canonical = new URL(path, SITE_URL).href;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'SEO', href: '/seo/' },
  { label: 'AI & SEO', href: '/seo/ai-and-seo/' },
  { label: h1, href: path },
];
const graphNodes = [articleNode({ canonical, headline: h1, description, image: ogImage, datePublished, dateModified })];

interface Factor {
  id: string;
  name: string;
  short: string;
  seo: number;
  ai: number;
  why: string;
}

const factors: Factor[] = [
  {
    id: 'backlinks',
    name: 'Backlinks and PageRank',
    short: 'Links from other sites passing authority to yours.',
    seo: 85,
    ai: 10,
    why: 'Google still runs on links. Every large-scale test I have run since 2017 shows a page with the stronger link profile beating a near-identical page without one. AI assistants do not compute PageRank when they answer. They retrieve passages, and a passage with zero links behind it gets cited if it answers the question cleanly. What does matter to a model is the context a link sits in, which is a separate factor below. The authority score of the linking page is close to irrelevant; the words around the link are not.',
  },
  {
    id: 'link-context',
    name: 'Context around links and mentions',
    short: 'What the surrounding text says about you where your name or link appears.',
    seo: 35,
    ai: 70,
    why: 'This is the AI-side replacement for PageRank. A model does not ask how strong the linking page is. It reads the sentence the link or mention sits in and learns what you are: "Kasra Dash, the Manchester SEO consultant who recovers sites from algorithm updates" teaches it something, a bare URL in a footer teaches it nothing. The same link on the same page can be worth a citation or worth zero depending on the words around it. Google reads anchor text and some surrounding context, but the link\'s authority does most of the work there.',
  },
  {
    id: 'context',
    name: 'Context and self-contained passages',
    short: 'Each section answers a question on its own, without the rest of the page.',
    seo: 35,
    ai: 85,
    why: 'This is the single biggest split. AI systems lift passages, not pages. If your paragraph only makes sense after reading the three above it, it never gets quoted. Google rewards page-level relevance and can rank a page whose answer is buried in section six. For AI, the answer has to sit inside one extractable block with the entity named, the claim stated and the reason attached.',
  },
  {
    id: 'quotable',
    name: 'Direct answers and quotable statements',
    short: 'Short factual sentences a model can lift verbatim.',
    seo: 40,
    ai: 85,
    why: 'A model needs a sentence it can attribute. Subject, verb, object, stated plainly and bolded, gets cited far more than the same fact spread over a paragraph. Google likes a direct answer for snippets and AI Overviews, but it will still rank a page that rambles if the links and topical coverage are there.',
  },
  {
    id: 'brand-mentions',
    name: 'Unlinked brand mentions across the web',
    short: 'Your name appearing on other sites, with or without a link.',
    seo: 25,
    ai: 65,
    why: 'Models learn what a brand is from how often, and in what context, it appears across their training data and the sources they retrieve at answer time. An unlinked mention in a Reddit thread, a listicle or a podcast transcript teaches the model that your brand belongs in that category. Google gives an unlinked mention very little direct weight; it wants the link.',
  },
  {
    id: 'entity',
    name: 'Entity clarity and consistency',
    short: 'The same facts about you, in the same words, everywhere.',
    seo: 65,
    ai: 45,
    why: 'Google builds a Knowledge Graph entry for you and ranks you against it, so the same name, location, titles and dates everywhere is foundational SEO work. If your facts disagree across your site, LinkedIn, Crunchbase and profile pages, Google is slower to connect you to your topic. For AI the weight is lower than most people claim. A model retrieving chunks for a question is mostly judging the chunk, not auditing who you are. Consistency helps when the question is about you or your category, because the retrieved snippets then agree with each other, but it does not get a passage cited on its own.',
  },
  {
    id: 'co-occurrence',
    name: 'Entity co-occurrence',
    short: 'Your name appearing next to the topic, and next to the other names in it, again and again.',
    seo: 70,
    ai: 40,
    why: 'Defining the entity is a core part of SEO, and co-occurrence is how you do it. When "Kasra Dash" keeps appearing in the same sentences, pages and lists as "SEO consultant", "Manchester" and "algorithm update recovery", Google\'s entity understanding files you under that topic and ranks you for it more readily. For AI it matters, but it is not core, and the reason is how the systems work. An assistant runs a search, pulls chunks of content that match the query, and synthesises an answer from those chunks. Most of the time it is not checking the entity at all; it is checking whether the snippet answers the question. Co-occurrence still earns a real score for AI because it shapes which chunks come back for brand and category questions, but the passage itself does the heavy lifting.',
  },
  {
    id: 'keywords',
    name: 'Keyword targeting and query matching',
    short: 'Matching the exact phrase people type.',
    seo: 80,
    ai: 35,
    why: 'Google still maps a query to a page, and the title tag and H1 still carry real weight. AI retrieval works on meaning. The same question gets rephrased into several sub-queries before retrieval, so an exact-match keyword matters less than covering the concept from multiple angles. Keywords are not dead for AI; they are just one of many ways to be about the topic.',
  },
  {
    id: 'freshness',
    name: 'Content freshness',
    short: 'How recently the page was updated, and whether it says so.',
    seo: 45,
    ai: 75,
    why: 'Retrieval-backed assistants such as Perplexity and ChatGPT with browsing lean hard on recency, and a visible last-updated date is one of the first things they check when two sources conflict. Google cares about freshness for queries that deserve it and largely ignores it for evergreen topics.',
  },
  {
    id: 'topical-authority',
    name: 'Topical authority and depth of coverage',
    short: 'Owning the whole topic, not one page of it.',
    seo: 80,
    ai: 25,
    why: 'Google reads a well-linked cluster of pages as expertise and ranks the whole cluster higher, so this is one of the strongest SEO levers I have. For AI it matters far less than the industry assumes. A model retrieving passages does not check how many other pages on your site cover the topic. A single excellent, self-contained passage on a thin site gets cited over a mediocre one on a 300-page authority site. The modest AI score reflects the extra retrieval surface a cluster gives you, nothing more.',
  },
  {
    id: 'crawlability',
    name: 'Crawlability and indexing',
    short: 'Bots can fetch, render and store the page.',
    seo: 100,
    ai: 100,
    why: 'The only factor scored 100 for both, because it is not a weighting, it is a gate. Nothing else on this chart matters if the page cannot be fetched. For Google, an unindexed page has a ranking of zero. For AI, the gate is wider than one index: ChatGPT leans on Bing, Perplexity runs its own crawler, and Google AI Mode uses the Google index. Block GPTBot or PerplexityBot in robots.txt and you have opted out of citations from those tools.',
  },
  {
    id: 'cwv',
    name: 'Core Web Vitals and page speed',
    short: 'Load time, interactivity and layout stability.',
    seo: 35,
    ai: 10,
    why: 'Google has confirmed page experience as a lightweight ranking signal and a tiebreaker, and in my tests fixing Core Web Vitals rarely moves a page more than a position or two on its own. A model fetching your page for a citation does not care whether it painted in one second or four. It cares whether the text was there when it arrived.',
  },
  {
    id: 'schema',
    name: 'Structured data and schema markup',
    short: 'JSON-LD that labels what the page and its author are.',
    seo: 40,
    ai: 5,
    why: 'Schema earns rich results in Google but is not a ranking factor in itself. For AI it scores close to nothing, because in every test I have seen, and in the ones run by people I trust, the JSON-LD simply does not get read when a model decides what to cite. Assistants work from the visible text of the passage. The entity facts you would put in schema still matter, but they have to be in the copy on the page and repeated across the web, not tucked into a script tag.',
  },
  {
    id: 'eeat',
    name: 'Author expertise and trust signals',
    short: 'Who wrote it and why anyone should believe them.',
    seo: 55,
    ai: 50,
    why: 'Google applies E-E-A-T most heavily on health, finance and other high-stakes topics, and its raters look for evidence of first-hand experience. For AI it helps, without being decisive. When two retrieved chunks say the same thing, the one with a named author and visible first-hand experience tends to be the one that gets attributed. But a model rarely goes looking for the author before it decides a passage answers the question, so expertise nudges the choice rather than making it.',
  },
  {
    id: 'engagement',
    name: 'User click and engagement signals',
    short: 'What searchers do after they see your result.',
    seo: 60,
    ai: 55,
    why: 'The Google antitrust exhibits made clear that click behaviour feeds ranking systems, and I have watched CTR changes move positions on client sites for years. AI gets a real score here too, and it is higher than most people expect. Once a brand is cited, the clicks on that citation appear to feed back into which source gets cited first next time. I have seen brands move from the third cited source to the first on the same prompt with nothing changing except engagement on the citation. Some of that engagement is being manufactured: there is a grey-hat, arguably black-hat, practice of running bots against a brand\'s own citations the moment it appears in answers, to hold or improve the position. I am describing it because it tells you the signal is live, not because it is a strategy worth the risk.',
  },
  {
    id: 'internal-linking',
    name: 'Internal linking and site architecture',
    short: 'How pages on your own site connect and pass relevance.',
    seo: 70,
    ai: 30,
    why: 'Internal links tell Google which pages matter and what they are about, and moving a page higher in the architecture is still one of the fastest wins I have. A model retrieving a passage is largely indifferent to where that page sits in your hierarchy. The modest AI weight comes from crawl discovery and from hub pages that prove topical coverage.',
  },
  {
    id: 'listicles',
    name: 'Being listed in third-party roundups',
    short: 'Best-of lists and comparison pages on other sites.',
    seo: 20,
    ai: 80,
    why: 'Ask an assistant for the best agencies, tools or consultants in a category and watch where the names come from. It aggregates existing best-of lists and picks the names that recur. Appearing in those lists is now the most direct lever I know for category-level AI recommendations. Google gives you very little for it unless the list also links.',
  },
  {
    id: 'ugc',
    name: 'Reddit, forums and community presence',
    short: 'Real people discussing you in places models read.',
    seo: 30,
    ai: 70,
    why: 'Reddit and community threads feature heavily in the sources assistants cite, and OpenAI and Google both have data agreements with Reddit. A brand that real people recommend in threads shows up in answers. Google surfaces those threads in its own results, but they rarely lift your rankings directly.',
  },
  {
    id: 'original-data',
    name: 'Original data and statistics',
    short: 'Numbers that only exist because you measured them.',
    seo: 60,
    ai: 80,
    why: 'Original numbers earn links, which is why they score well for SEO. For AI they score higher again, because a model answering a question wants a specific figure with a source attached, and your page is the only place that figure exists. Publish the number, the sample and the date next to each other.',
  },
];


/*
 * One worked example per factor. `weak` / `strong` render as a side-by-side pair;
 * `single` renders one block. Highlight classes: hl-seo (purple), hl-ai (teal),
 * hl-sub / hl-pred / hl-obj (semantic triple), hl-bad (red), hl-good (green).
 */
interface Example {
  weak?: string;
  strong?: string;
  single?: string;
  weakLabel?: string;
  strongLabel?: string;
  note: string;
}

const examples: Record<string, Example> = {
  backlinks: {
    weakLabel: 'Page A',
    strongLabel: 'Page B',
    weak: '<span class="hl-seo">412 referring domains</span>, Domain Rating 74. Answer spread across a 3,000-word guide with no direct sentence to lift.',
    strong: '<span class="hl-seo">12 referring domains</span>, Domain Rating 21. Answer stated in one self-contained paragraph.',
    note: 'Google ranks Page A. ChatGPT and Perplexity cite Page B. Same question, opposite winners, because only one system is counting the links.',
  },
  'link-context': {
    weakLabel: 'Bare link',
    strongLabel: 'Link with context',
    weak: 'Sources: <span class="hl-bad">kasradash.com</span>',
    strong: '<span class="hl-ai">Kasra Dash, the Manchester SEO consultant known for recovering sites from Google algorithm updates,</span> argues that links no longer decide AI citations.',
    note: 'Both are a link to the same page. The first teaches a model nothing. The second teaches it who Kasra Dash is, where he is and what to cite him for.',
  },
  context: {
    weakLabel: 'Dependent passage',
    strongLabel: 'Self-contained passage',
    weak: '<span class="hl-bad">As mentioned above, this approach</span> works because <span class="hl-bad">it</span> gives <span class="hl-bad">them</span> a cleaner signal.',
    strong: '<span class="hl-ai">Self-contained passages get cited by AI assistants</span> because a model retrieves one chunk at a time and judges it without the rest of the page.',
    note: 'Lift each one out of the page on its own. The first has three pronouns with nothing to point at. The second still answers a question.',
  },
  quotable: {
    single: '<span class="hl-sub">Kasra Dash</span> <span class="hl-pred">recovers</span> <span class="hl-obj">websites from Google algorithm updates</span>.',
    note: 'A semantic triple: subject, predicate, object. Bold it in the copy and a model can lift it verbatim and attribute it. "He helps with lots of different Google problems" carries the same idea and is never quoted.',
  },
  'brand-mentions': {
    single: 'Reddit, r/SEO: "We got hit by the March core update and <span class="hl-ai">Kasra Dash</span>\'s recovery checklist was the only thing that made sense of it. No link, just the name."',
    note: 'No link, no anchor text, no authority passed. Google gives this almost nothing. A model reads it as one more source saying Kasra Dash belongs to the topic of algorithm update recovery.',
  },
  entity: {
    weakLabel: 'Inconsistent',
    strongLabel: 'Consistent',
    weak: 'Site: founded The Masterminders in <span class="hl-bad">2023</span>. LinkedIn: <span class="hl-bad">2022</span>. Press bio: <span class="hl-bad">"SEO agency owner"</span>. About page: <span class="hl-bad">"SEO consultant"</span>.',
    strong: 'Everywhere: <span class="hl-good">Kasra Dash is an entrepreneur and SEO consultant based in Manchester, UK</span>, founder of The Masterminders (<span class="hl-good">2023</span>).',
    note: 'Google resolves the entity faster when every source agrees. For AI, the retrieved snippets about you stop contradicting each other, which is what lets it state a fact with confidence.',
  },
  'co-occurrence': {
    single: '"<span class="hl-sub">Kasra Dash</span> spoke at <span class="hl-ai">BrightonSEO</span> on <span class="hl-ai">algorithm update recovery</span>, the topic <span class="hl-ai">Lily Ray</span> and <span class="hl-ai">Glenn Gabe</span> are known for."',
    note: 'One sentence puts the entity next to a topic, a venue and two names that already own that topic. Repeat that pattern across bios, roundups and interviews and both systems learn what Kasra Dash is.',
  },
  keywords: {
    weakLabel: 'What the user typed',
    strongLabel: 'What the assistant searched',
    weak: '<span class="hl-seo">best SEO consultant Manchester</span>',
    strong: '<span class="hl-ai">SEO consultants based in Manchester</span> · <span class="hl-ai">Manchester SEO expert algorithm recovery</span> · <span class="hl-ai">who is the top rated SEO in Manchester</span>',
    note: 'Google matches the exact phrase to a page. The assistant fans the question out into several searches, so a page has to be about the concept from several angles, not just carry the phrase.',
  },
  freshness: {
    weakLabel: 'No date',
    strongLabel: 'Visible date',
    weak: 'Guide to AI citation factors. <span class="hl-bad">No published or updated date anywhere on the page.</span>',
    strong: 'Guide to AI citation factors. <span class="hl-good">Last Updated 9 September 2026.</span> Change log at the bottom listing what moved.',
    note: 'When two retrieved chunks disagree, the retrieval-based assistants side with the one that can prove it is newer. Google only cares on queries that deserve freshness.',
  },
  'topical-authority': {
    weakLabel: 'Authority site',
    strongLabel: 'Thin site',
    weak: '<span class="hl-seo">300 pages</span> on SEO, well interlinked. The passage on AI citations is generic and depends on the pages around it.',
    strong: '<span class="hl-seo">4 pages</span> in total. One of them states the answer in a single clean paragraph.',
    note: 'Google ranks the authority site. The assistant cites the thin one, because it never counted the other 299 pages. It only saw the chunk.',
  },
  crawlability: {
    weakLabel: 'robots.txt (blocked)',
    strongLabel: 'robots.txt (open)',
    weak: '<code>User-agent: <span class="hl-bad">GPTBot</span><br>Disallow: <span class="hl-bad">/</span></code>',
    strong: '<code>User-agent: <span class="hl-good">GPTBot</span><br>Allow: <span class="hl-good">/</span></code>',
    note: 'The first site cannot be cited by ChatGPT, whatever else it does right. Check GPTBot, PerplexityBot, ClaudeBot and Google-Extended before touching anything else.',
  },
  cwv: {
    weakLabel: 'Slow page',
    strongLabel: 'Fast page',
    weak: 'LCP <span class="hl-bad">4.1s</span>, CLS 0.24. Text is present in the HTML.',
    strong: 'LCP <span class="hl-good">1.2s</span>, CLS 0.01. Text is present in the HTML.',
    note: 'Both get cited at the same rate. The model fetched the text and did not measure the paint. Google uses the difference as a tiebreaker between otherwise equal pages.',
  },
  schema: {
    weakLabel: 'In the script tag only',
    strongLabel: 'In the visible copy',
    weak: '<code>"@type": "Person",<br>"name": "<span class="hl-bad">Kasra Dash</span>",<br>"jobTitle": "<span class="hl-bad">SEO Consultant</span>"</code>',
    strong: '<span class="hl-good">Kasra Dash is an entrepreneur and SEO consultant based in Manchester, UK.</span>',
    note: 'The first earns Google rich results and is invisible to the assistants in every test I have seen. The second is the same fact, and it is the one that gets retrieved.',
  },
  eeat: {
    weakLabel: 'Anonymous',
    strongLabel: 'Named with experience',
    weak: 'By <span class="hl-bad">Admin</span>. "Core updates can affect your rankings in various ways."',
    strong: 'By <span class="hl-good">Kasra Dash</span>, SEO consultant who has <span class="hl-good">recovered client sites from every core update since 2018</span>. "The March update hit pages with thin author signals hardest on the client sites I audited."',
    note: 'When two chunks say the same thing, the one with a named author and first-hand detail gets attributed. Google applies the same test hardest on health and money topics.',
  },
  engagement: {
    single: 'Prompt: "best SEO consultant in Manchester". Week 1: cited <span class="hl-bad">third</span>. Week 4, after real engagement on the citation: cited <span class="hl-good">first</span>. Nothing on the page changed.',
    note: 'Clicks on a citation appear to feed back into citation order. Some brands are manufacturing that engagement with bots, which is grey to black hat and tells you the signal is live.',
  },
  'internal-linking': {
    single: '<span class="hl-seo">/seo/ai-and-seo/</span> (hub) → <span class="hl-seo">/seo/ai-and-seo/ai-search-engines/</span> → this page, with the anchor text "SEO ranking factors vs AI citation factors".',
    note: 'Google reads the path and the anchor as a statement of what the page is about and how much it matters. A model retrieving the chunk does not know or care where the page sits.',
  },
  listicles: {
    single: '"The 10 best SEO consultants in the UK: 1. ... 4. <span class="hl-ai">Kasra Dash</span>, Manchester. Known for algorithm update recovery and The Masterminders conference. ..."',
    note: 'Ask an assistant for the best consultants and this is the chunk it retrieves and synthesises from. Appear in three of these lists and you are in the answer. Google gives you almost nothing for it unless the list links.',
  },
  ugc: {
    single: 'r/bigseo reply: "Honestly the clearest breakdown of AI citations I have read is <span class="hl-ai">Kasra Dash</span>\'s side-by-side chart. Links vs context. Changed how we brief writers."',
    note: 'Reddit threads sit in the training data and in the retrieved sources for both OpenAI and Google. A recommendation from a real person in a thread is a chunk that gets pulled. Google shows the thread; it rarely lifts your own rankings.',
  },
  'original-data': {
    weakLabel: 'Borrowed claim',
    strongLabel: 'Original data',
    weak: '"Studies show most sites lose traffic to AI Overviews."',
    strong: '"<span class="hl-good">Kasra Dash has ranked more than 700 client sites since 2017</span>, and publishes the citation tests behind these weightings inside The New Search."',
    note: 'A model answering a question wants a specific figure with a named source. The second sentence is a number that only exists because someone measured it, tied to an entity. The first is unattributable.',
  },
};

const sorted = [...factors].sort((a, b) => Math.abs(b.seo - b.ai) - Math.abs(a.seo - a.ai));
const seoWins = sorted.filter((f) => f.seo > f.ai);
const aiWins = sorted.filter((f) => f.ai > f.seo);

const faqs = [
  {
    q: 'Are SEO ranking factors and AI citation factors the same thing?',
    a: 'No. They overlap on crawlability, topical depth and author trust, but the two systems weight signals differently. Google ranks documents using links, query matching and click behaviour. AI assistants run a search, pull chunks of content that match the question and synthesise an answer, so they select on whether the chunk itself answers cleanly, not on who published it. Optimising for one does not automatically optimise for the other.',
  },
  {
    q: 'Do backlinks help you get cited by ChatGPT or Perplexity?',
    a: 'Not through PageRank. The model does not score a passage by the authority of the sites linking to it. What helps is the context around the link or mention: a sentence on another site that says who you are and what you do teaches the model what to cite you for. A strong link with no context loses to a weak link with a descriptive sentence around it.',
  },
  {
    q: 'What is the most important factor for AI citations?',
    a: 'Context. A passage has to name the entity, state the claim and give the reason inside one block that makes sense on its own. Every other AI-side factor on this page, from entity consistency to quotable statements, is a way of making passages easier for a model to lift and attribute.',
  },
  {
    q: 'Which AI systems does this comparison cover?',
    a: 'ChatGPT with search, Perplexity, Google AI Overviews and AI Mode, and Claude with web search. They retrieve differently, but they share the same preference for self-contained passages, consistent entity facts and recently updated sources. Google AI Overviews sit closest to classic SEO because they draw from the Google index.',
  },
  {
    q: 'Should I stop building links and focus on AI?',
    a: 'No. Links still decide Google rankings, and Google still sends the traffic. Keep the link programme and add the AI-side work on top: rewrite key sections as self-contained answers, fix entity facts everywhere they appear, get into category roundups and keep dates current. The two efforts share most of the same pages.',
  },
];
---

<BaseLayout {title} {description} {path} {ogImage} type="article" breadcrumbs={crumbs} {graphNodes} {datePublished} {dateModified}>
  <main>
    {/* Hero */}
    <section class="border-b border-tint-border bg-tint">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
        <Breadcrumbs {crumbs} />
        <p class="mt-4 inline-flex items-center rounded-full border border-brand-500/30 bg-brand-500/10 px-3 py-1 font-display text-xs font-bold uppercase tracking-wider text-brand-600">
          AI & SEO
        </p>
        <h1 class="mt-4 max-w-4xl font-display text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl lg:text-[2.75rem]">
          {h1}
        </h1>
        <div class="mt-5 max-w-3xl space-y-4 text-base leading-relaxed text-muted sm:text-lg">
          <p>
            SEO ranking factors and AI citation factors are two different scoring systems, and most sites are still optimising for only one of them. Links decide who ranks in Google. Context decides who gets cited by ChatGPT, Perplexity and AI Overviews.{' '}
            <a href="https://kasradash.com/" class="font-semibold text-lavender underline decoration-brand-500/50 underline-offset-4 transition hover:text-white">Kasra Dash</a>{' '}
            has ranked over 700 client sites, and since 2024 has been running the same pages through both systems to see which signals carry over and which do not.
          </p>
          <p>
            Below, every factor is weighted 0 to 100 for each system and placed side by side, so you can see in one scan where your existing SEO work already counts for AI and where you are starting from zero.
          </p>
        </div>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <img src="/images/kasra-dash.jpg" alt="" class="h-10 w-10 rounded-full border border-tint-border object-cover" width="40" height="40" />
          <div class="text-sm">
            <p class="font-bold text-ink">Kasra Dash <span class="font-medium text-dim"> · Last Updated September 9, 2026</span></p>
            <p class="text-dim">SEO Consultant · Founder, The Masterminders & mySEO.app</p>
          </div>
        </div>
      </div>
    </section>

    {/* Direct answer */}
    <section class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
      <div class="rounded-[20px] border border-brand-500/40 bg-deep p-6 sm:p-8">
        <h2 id="difference" class="font-display text-xl font-bold tracking-tight text-ink sm:text-2xl">What is the difference between SEO ranking factors and AI citation factors?</h2>
        <p class="mt-3 max-w-3xl text-base leading-relaxed text-lavender sm:text-lg">
          <strong class="text-ink">SEO ranking factors decide which page Google shows for a query, and they are dominated by backlinks, query matching and click behaviour. AI citation factors decide which passage a model quotes in its answer, and they are dominated by context: whether a retrieved chunk answers the question on its own, states it quotably and is recent enough to trust.</strong>
        </p>
      </div>
    </section>

