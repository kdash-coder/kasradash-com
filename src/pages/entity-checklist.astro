---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_URL } from '../lib/site';
import { CAPTURE_ENDPOINT, captureEnabled } from '../lib/capture';

/*
 * The Entity Statement Checklist: opt-in page linked from the entity statements YouTube video.
 *
 * Same capture path as every other form on the site: src/lib/capture-client.ts
 * posts to the universal GoHighLevel webhook ("Website email capture (universal)").
 * UTMs come from <Attribution /> (first + last touch), so a link like
 *   /entity-checklist/?utm_source=youtube&utm_medium=video&utm_campaign=entity-statements&utm_content=description
 * lands utm_source/medium/campaign/content on the submission.
 *
 * asset_name + asset_url are what the universal welcome email links to.
 * The PDF lives at public/downloads/entity-statement-checklist.pdf: overwrite
 * that file and push to main to update it. The URL never changes.
 *
 * Unlike <EmailSignup />, this form is never hidden for people already subscribed
 * on this device: everyone who lands here came for the checklist.
 */
const path = '/entity-checklist/';
const title = 'The Entity Statement Checklist (Free PDF)';
const description =
  'Turn "years of experience" and "award-winning" into facts Google and AI can check: before-and-after rewrites, a fact sheet to fill in, a 60-second check with Google\'s Natural Language demo and an entity-rich branded-link template.';
const SOURCE = 'lm-entity-statements';
const TAG = 'lm-entity-statements';
const ASSET_NAME = 'The Entity Statement Checklist';
const ASSET_URL = `${SITE_URL}/downloads/entity-statement-checklist.pdf`;
const SKOOL = 'https://www.skool.com/the-new-search';

const bullets = [
  'Before-and-after rewrites for the three sentences on almost every business website',
  'A fact sheet to fill in: founded, founder, services, awards, reviews',
  "A 60-second check with Google's free Natural Language demo",
  'How to find your attributes, by hand or in Rank OS',
  'A copy-and-paste template for entity-rich branded links',
];
---

<BaseLayout {title} {description} {path} datePublished="2026-11-26T12:00:00+00:00">
  <main class="border-b border-tint-border bg-tint">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-start lg:py-20">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-deep px-3.5 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-brand-600">Free PDF</p>
        <h1 class="mt-4 max-w-2xl font-display text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl lg:text-[2.9rem]" style="text-wrap:balance">
          The Entity Statement Checklist
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">Stop writing claims Google can't check. Write facts it can. Free.</p>
        <ul class="mt-8 grid gap-3.5 text-base text-ink">
          {bullets.map((b) => (
            <li class="flex items-start gap-3">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-[#2dd4bf]" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <div
        class="lm-box"
        id="lm-form"
        data-endpoint={CAPTURE_ENDPOINT}
        data-source={SOURCE}
        data-tag={TAG}
        data-asset-name={ASSET_NAME}
        data-asset-url={ASSET_URL}
      >
        <div class="lm-ask">
          <h2 class="font-display text-2xl font-bold leading-tight tracking-tight text-ink">Get the checklist</h2>
          <p class="mt-2 text-base leading-relaxed text-muted">Enter your name and email and I'll send the PDF straight to your inbox.</p>
          <form class="mt-6 grid gap-3" novalidate>
            <label class="sr-only" for="lm-name">First name</label>
            <input id="lm-name" name="first_name" type="text" required autocomplete="given-name" placeholder="First name" maxlength="60" class="lm-input" />
            <label class="sr-only" for="lm-email">Email address</label>
            <input id="lm-email" name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@company.com" maxlength="120" class="lm-input" />
            {/* Honeypot: real people never see or fill this. */}
            <div class="lm-hp" aria-hidden="true">
              <label>Company website <input name="company_website" type="text" tabindex="-1" autocomplete="off" /></label>
            </div>
            <button type="submit" class="btn-gradient mt-1 inline-flex items-center justify-center rounded-full px-7 py-3.5 text-base font-bold text-white">Send me the checklist</button>
          </form>
          <p class="lm-error mt-3 text-sm text-[#fca5a5]" role="alert" hidden></p>
          <p class="mt-4 text-xs leading-relaxed text-dim">
            You will also get my SEO and AI search emails. Unsubscribe in one click. See the{' '}
            <a href="/privacy-policy/" class="underline hover:text-muted">privacy policy</a>.
          </p>
        </div>

        <div class="lm-done" hidden>
          <h2 class="font-display text-2xl font-bold leading-tight tracking-tight text-ink" tabindex="-1">It's on its way to your inbox.</h2>
          <p class="mt-3 text-base leading-relaxed text-muted">If it isn't there in a few minutes, check your spam or Promotions folder. Or grab it right now:</p>
          <a href={ASSET_URL} target="_blank" rel="noopener" class="btn-gradient mt-5 inline-flex items-center justify-center rounded-full px-7 py-3.5 text-base font-bold text-white">Download the checklist (PDF)</a>
          <p class="mt-8 border-t border-tint-border pt-6 text-base leading-relaxed text-ink">
            If you'd rather not work through this alone, The New Search is where we test this stuff. You get Rank OS the day you join, and a live call every Wednesday where you can bring your own site.
          </p>
          <a href={SKOOL} target="_blank" rel="noopener" class="btn-gradient mt-6 inline-flex items-center justify-center rounded-full px-7 py-3.5 text-base font-bold text-white">Join The New Search <span aria-hidden="true" class="ml-1.5">→</span></a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .lm-box {
    border-radius: 24px;
    border: 2px solid #845cfe;
    padding: 1.75rem;
    background:
      radial-gradient(120% 140% at 0% 0%, rgba(132, 92, 254, 0.22), transparent 55%),
      radial-gradient(90% 120% at 100% 100%, rgba(45, 212, 191, 0.1), transparent 60%),
      var(--color-tint);
    box-shadow: 0 0 0 6px rgba(132, 92, 254, 0.1), 0 24px 70px -20px rgba(132, 92, 254, 0.55);
  }
  @media (min-width: 640px) {
    .lm-box { padding: 2.5rem; }
  }
  .lm-input {
    width: 100%;
    border-radius: 9999px;
    border: 1px solid rgba(132, 92, 254, 0.45);
    background: #000;
    color: var(--color-ink);
    padding: 0.9rem 1.2rem;
    font-size: 1rem;
  }
  .lm-input::placeholder { color: var(--color-dim); }
  .lm-input:focus { outline: 2px solid var(--color-brand-500); outline-offset: 1px; }
  .lm-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>

{
  captureEnabled && (
    <script>
      import { readForm, submitCapture } from '../lib/capture-client';

      const box = document.querySelector<HTMLElement>('#lm-form');
      const form = box?.querySelector<HTMLFormElement>('form');
      if (box && form) {
        const errorEl = box.querySelector<HTMLElement>('.lm-error')!;
        const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const values = readForm(form, errorEl);
          if (!values || values === 'bot') return;
          button.disabled = true;
          button.textContent = 'Sending…';
          await submitCapture({
            endpoint: box.dataset.endpoint!,
            email: values.email,
            firstName: values.firstName,
            source: box.dataset.source ?? '',
            tag: box.dataset.tag ?? '',
            assetName: box.dataset.assetName ?? '',
            assetUrl: box.dataset.assetUrl ?? '',
          });
          try {
            (window as any).gtag?.('event', 'generate_lead', { lead_source: box.dataset.source });
          } catch {
            /* analytics is optional */
          }
          box.querySelector<HTMLElement>('.lm-ask')!.hidden = true;
          const done = box.querySelector<HTMLElement>('.lm-done')!;
          done.hidden = false;
          done.querySelector<HTMLElement>('h2')?.focus();
        });
      }
    </script>
  )
}
