---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const title = 'Free AI SEO Sheet - Kasra Dash';
const description =
  'Get the free AI SEO sheet from Kasra Dash: the prompts, workflows and checks his team uses to combine AI with SEO. Enter your details and it lands in your inbox.';

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Free AI SEO Sheet', href: '/free-ai-seo-sheet/' },
];
---

<BaseLayout {title} {description} path="/free-ai-seo-sheet/" breadcrumbs={crumbs}>
  <main>
    <section class="relative overflow-hidden border-b border-tint-border bg-tint">
      <div class="pointer-events-none absolute -right-32 -top-32 h-80 w-80 rounded-full bg-brand-500/15 blur-3xl" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <Breadcrumbs {crumbs} />
        <h1 class="mt-4 max-w-3xl font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">Free AI SEO Sheet</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
          The exact AI prompts and workflows Kasra Dash and his team use to speed up SEO work without losing quality. Free, straight to your inbox.
        </p>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1fr_20rem]">
      <div class="overflow-hidden rounded-2xl border border-tint-border bg-white">
        <iframe
          src="https://api.leadconnectorhq.com/widget/form/Pxcgxgcb1znuNO3pJJud"
          title="Get the free AI SEO sheet"
          class="h-[640px] w-full"
          loading="lazy"
        ></iframe>
      </div>
      <aside class="space-y-6">
        <div class="rounded-2xl border border-tint-border bg-tint p-6">
          <h2 class="font-display text-lg font-bold text-ink">Want to go deeper on AI and SEO?</h2>
          <ul class="mt-4 space-y-2.5 text-sm">
            <li><a href="/seo/ai-and-seo/" class="font-semibold text-ink hover:text-brand-600 hover:underline">AI & SEO hub</a></li>
            <li><a href="/seo/ai-and-seo/ai-seo-tools/" class="font-semibold text-ink hover:text-brand-600 hover:underline">AI SEO tools</a></li>
            <li><a href="/seo/ai-and-seo/prompt-engineering/" class="font-semibold text-ink hover:text-brand-600 hover:underline">Prompt engineering for SEO</a></li>
            <li><a href="/seo/seo-frameworks/ai-workflow-templates/" class="font-semibold text-ink hover:text-brand-600 hover:underline">AI workflow templates</a></li>
          </ul>
        </div>
      </aside>
    </section>
  </main>
</BaseLayout>
