---
/*
 * EmailGate: an inline registration wall for one section of a page.
 *
 * HOW IT LOCKS
 *   Elements on the page marked `data-gated={gateId}` are the locked content.
 *   They are ALWAYS in the server-rendered HTML. Locking is a class on <html>
 *   (`gate-locked-{gateId}`) added by an inline script, and removed once the
 *   visitor submits their email (remembered in localStorage).
 *
 *   - No JavaScript (LLM crawlers, reader modes): nothing locks, full content.
 *   - Googlebot (renders JS): sees the wall, plus the `isAccessibleForFree`
 *     structured data the page adds, which is Google's sanctioned pattern for
 *     registration walls and is what stops this being treated as cloaking.
 *   - Humans: first gated element shows as a faded teaser, the rest are hidden.
 *
 * WHERE THE EMAIL GOES
 *   POSTed to CAPTURE_ENDPOINT (a GoHighLevel Inbound Webhook). See
 *   src/lib/capture.ts. While that is empty this component renders NOTHING and
 *   no content locks.
 *
 * WHAT IS SENT (form-encoded so it works cross-origin without CORS)
 *   Built by src/lib/capture-client.ts, shared with <EmailSignup />.
 *   email, first_name, source, tag, asset_name, asset_url, page_url, page_path, page_title,
 *   utm_source|medium|campaign|term|content   (last touch, else first touch)
 *   first_utm_source|medium|campaign, first_landing, first_referrer, first_seen
 *   fbclid|gclid, referrer, consent, submitted_at
 *
 *   `source` is the page slug. `tag` is "src:<slug>". The GoHighLevel workflow
 *   adds `tag` to the contact, so every lead shows which page it came from.
 */
import { CAPTURE_ENDPOINT, captureEnabled, sourceTag } from '../lib/capture';

interface Props {
  /** Unique per page. Matches the `data-gated` value on locked elements. */
  gateId: string;
  /** Page slug, becomes the GoHighLevel source + tag. */
  source: string;
  heading: string;
  blurb: string;
  button?: string;
  /** How many items are behind the wall, shown in the UI. */
  lockedCount?: number;
  /** What they are signing up to get. Becomes the first line of the universal welcome email. */
  assetName?: string;
  /** Link to it (absolute). Defaults to this page. */
  assetUrl?: string;
  /** Next few locked items, drawn blurred above the form as a teaser. */
  peek?: { name: string; seo: number; ai: number }[];
  /** Short benefit bullets shown with ticks above the form. */
  points?: string[];
  /** Bold line under the form saying what happens the moment they submit. */
  instantNote?: string;
}

const { gateId, source, heading, blurb, button = 'Unlock the full list', lockedCount, assetName = '', assetUrl = '', points = [], peek = [], instantNote = 'Opens on this page the moment you hit the button. No confirmation email to wait for.' } = Astro.props;
const tag = sourceTag(source);
---

{
  captureEnabled && (
    <>
      <script is:inline define:vars={{ gateId }}>
        try {
          if (!localStorage.getItem('kd_unlocked_' + gateId)) {
            document.documentElement.classList.add('gate-locked-' + gateId);
          }
        } catch (e) {
          document.documentElement.classList.add('gate-locked-' + gateId);
        }
      </script>

      <div
        id={`gate-${gateId}`}
        class="email-gate not-prose scroll-mt-28"
        data-gate={gateId}
        data-endpoint={CAPTURE_ENDPOINT}
        data-source={source}
        data-tag={tag}
        data-asset-name={assetName}
        data-asset-url={assetUrl}
      >
        {/* Blurred copies of the next locked rows, so it is obvious more factors sit behind the form. Decorative only. */}
        {peek.length > 0 && (
          <div class="email-gate-peek" aria-hidden="true">
            {peek.map((row) => (
              <div class="email-gate-peek-row">
                <span class="email-gate-peek-name">{row.name}</span>
                <span class="email-gate-peek-bars">
                  <span class="email-gate-peek-track"><i style={`width:${row.seo}%`} /></span>
                  <span class="email-gate-peek-track is-ai"><i style={`width:${row.ai}%`} /></span>
                </span>
                <span class="email-gate-peek-badge">+{Math.abs(row.seo - row.ai)}</span>
              </div>
            ))}
          </div>
        )}

        <div class="email-gate-box">
          <div class="flex items-center gap-3">
            <span class="email-gate-lock" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd" /></svg>
            </span>
            <p class="font-display text-xs font-bold uppercase tracking-wider text-brand-600">
              {lockedCount ? `${lockedCount} factors locked` : 'The rest is locked'}
            </p>
          </div>
          <h3 class="mt-4 font-display text-2xl font-bold leading-tight tracking-tight text-ink sm:text-3xl">{heading}</h3>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-muted">{blurb}</p>

          {points.length > 0 && (
            <ul class="mt-5 grid gap-2.5 text-sm text-ink sm:text-base">
              {points.map((pt) => (
                <li class="flex items-start gap-2.5">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-5 w-5 shrink-0 text-[#2dd4bf]" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          )}

          <form class="email-gate-form mt-6 grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_auto]" novalidate>
            <label class="sr-only" for={`gate-name-${gateId}`}>First name</label>
            <input
              id={`gate-name-${gateId}`}
              name="first_name"
              type="text"
              required
              autocomplete="given-name"
              placeholder="First name"
              maxlength="60"
              class="email-gate-input"
            />
            <label class="sr-only" for={`gate-email-${gateId}`}>Email address</label>
            <input
              id={`gate-email-${gateId}`}
              name="email"
              type="email"
              required
              autocomplete="email"
              inputmode="email"
              placeholder="you@company.com"
              maxlength="120"
              class="email-gate-input"
            />
            {/* Honeypot: real people never see or fill this. */}
            <div class="email-gate-hp" aria-hidden="true">
              <label>
                Company website
                <input name="company_website" type="text" tabindex="-1" autocomplete="off" />
              </label>
            </div>
            <button type="submit" class="btn-gradient inline-flex items-center justify-center gap-2 rounded-full px-7 py-3.5 text-base font-bold text-white">
              {button}
            </button>
          </form>

          <p class="email-gate-error mt-3 text-sm text-[#fca5a5]" role="alert" hidden></p>
          <p class="mt-4 text-sm font-semibold text-ink">{instantNote}</p>
          <p class="mt-1.5 text-xs leading-relaxed text-dim">
            You will also get my SEO and AI search emails. Unsubscribe in one click. See the{' '}
            <a href="/privacy-policy/" class="underline hover:text-muted">privacy policy</a>.
          </p>
        </div>
      </div>

      <style is:global>
        .email-gate-input {
          width: 100%;
          border-radius: 9999px;
          border: 1px solid var(--color-tint-border);
          background: #000;
          color: var(--color-ink);
          padding: 0.75rem 1.1rem;
          font-size: 0.95rem;
        }
        .email-gate-input::placeholder {
          color: var(--color-dim);
        }
        .email-gate-input:focus {
          outline: 2px solid var(--color-brand-500);
          outline-offset: 1px;
        }
        .email-gate-hp {
          position: absolute;
          left: -9999px;
          width: 1px;
          height: 1px;
          overflow: hidden;
        }
        .email-gate {
          display: none;
        }
        .email-gate-box {
          position: relative;
          border-radius: 24px;
          border: 2px solid #845cfe;
          padding: 1.75rem;
          background:
            radial-gradient(120% 140% at 0% 0%, rgba(132, 92, 254, 0.22), transparent 55%),
            radial-gradient(90% 120% at 100% 100%, rgba(45, 212, 191, 0.1), transparent 60%),
            var(--color-tint);
          box-shadow: 0 0 0 6px rgba(132, 92, 254, 0.1), 0 24px 70px -20px rgba(132, 92, 254, 0.55);
        }
        @media (min-width: 640px) {
          .email-gate-box {
            padding: 2.5rem;
          }
        }
        .email-gate-lock {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          height: 2.5rem;
          width: 2.5rem;
          border-radius: 9999px;
          color: #fff;
          background-image: linear-gradient(93.77deg, #845cfe 13.53%, #4a4ef8 88.57%);
        }
        .email-gate-box .email-gate-input {
          padding: 0.9rem 1.2rem;
          font-size: 1rem;
          border-color: rgba(132, 92, 254, 0.45);
        }
        .email-gate-peek {
          display: grid;
          gap: 0.75rem;
          margin-bottom: -3.5rem;
          pointer-events: none;
          user-select: none;
          -webkit-mask-image: linear-gradient(#000 35%, transparent 96%);
          mask-image: linear-gradient(#000 35%, transparent 96%);
        }
        .email-gate-peek-row {
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          gap: 0.9rem;
          align-items: center;
          border-radius: 20px;
          border: 1px solid var(--color-tint-border);
          background: var(--color-tint);
          padding: 1.4rem 1.5rem;
        }
        @media (min-width: 640px) {
          .email-gate-peek-row {
            grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.6fr) auto;
            gap: 1.5rem;
          }
        }
        .email-gate-peek-row > * {
          filter: blur(7px);
        }
        @media (max-width: 639px) {
          .email-gate-peek-row {
            padding: 1rem 1.25rem;
            gap: 0.6rem;
          }
          .email-gate-peek-row:nth-child(n + 3),
          .email-gate-peek-badge {
            display: none;
          }
        }
        .email-gate-peek-name {
          font-family: var(--font-display, inherit);
          font-weight: 700;
          font-size: 1.05rem;
          color: var(--color-ink);
        }
        .email-gate-peek-bars {
          display: grid;
          gap: 0.75rem;
        }
        .email-gate-peek-track {
          display: block;
          height: 0.55rem;
          border-radius: 9999px;
          background: rgba(255, 255, 255, 0.08);
        }
        .email-gate-peek-track i {
          display: block;
          height: 100%;
          border-radius: 9999px;
          background: #845cfe;
        }
        .email-gate-peek-track.is-ai i {
          background: #2dd4bf;
        }
        .email-gate-peek-badge {
          justify-self: start;
          border-radius: 9999px;
          border: 1px solid rgba(132, 92, 254, 0.5);
          padding: 0.25rem 0.75rem;
          font-weight: 700;
          font-size: 0.85rem;
          color: var(--color-ink);
        }
      </style>

      {/* Per-gate lock rules. Generated per gateId so several gates can coexist. */}
      <Fragment
        set:html={`<style>
html.gate-locked-${gateId} #gate-${gateId}{display:block;margin-top:2rem}
html.gate-locked-${gateId} [data-gated="${gateId}"]{display:none}
html.gate-locked-${gateId} [data-gated="${gateId}"][data-gate-teaser]{display:block;max-height:11rem;overflow:hidden;pointer-events:none;user-select:none;-webkit-mask-image:linear-gradient(#000 15%,transparent 95%);mask-image:linear-gradient(#000 15%,transparent 95%)}
</style>`}
      />

      <script>
        import { readForm, submitCapture } from '../lib/capture-client';

        document.querySelectorAll<HTMLElement>('.email-gate[data-gate]').forEach((gate) => {
          const gateId = gate.dataset.gate!;
          const lockClass = `gate-locked-${gateId}`;
          const form = gate.querySelector<HTMLFormElement>('form')!;
          const errorEl = gate.querySelector<HTMLElement>('.email-gate-error')!;
          const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
          const isLocked = () => document.documentElement.classList.contains(lockClass);

          // Any in-page link or chart row pointing at a locked item lands on the form instead.
          const redirectIfLocked = (id: string) => {
            if (!isLocked() || !id) return false;
            const target = document.getElementById(id);
            if (!target || target.dataset.gated !== gateId || target.hasAttribute('data-gate-teaser')) return false;
            // Scroll first, focus after: focusing an input cancels an in-flight smooth scroll.
            const y = gate.getBoundingClientRect().top + window.scrollY - Math.max(96, (window.innerHeight - gate.offsetHeight) / 2);
            window.scrollTo({ top: y, behavior: 'smooth' });
            window.setTimeout(() => form.querySelector<HTMLInputElement>('input[name="first_name"], input[name="email"]')?.focus({ preventScroll: true }), 700);
            return true;
          };
          document.addEventListener(
            'click',
            (e) => {
              const el = (e.target as HTMLElement).closest<HTMLElement>('[data-target], a[href^="#"]');
              if (!el) return;
              const id = el.dataset.target ?? (el.getAttribute('href') ?? '').slice(1);
              if (redirectIfLocked(id)) {
                e.preventDefault();
                e.stopImmediatePropagation();
              }
            },
            true
          );
          if (location.hash) redirectIfLocked(location.hash.slice(1));

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const values = readForm(form, errorEl);
            if (!values || values === 'bot') return;

            button.disabled = true;
            const label = button.textContent;
            button.textContent = 'Unlocking…';
            await submitCapture({
              endpoint: gate.dataset.endpoint!,
              email: values.email,
              firstName: values.firstName,
              source: gate.dataset.source ?? '',
              tag: gate.dataset.tag ?? '',
              assetName: gate.dataset.assetName ?? '',
              assetUrl: gate.dataset.assetUrl || location.origin + location.pathname,
            });
            try {
              localStorage.setItem(`kd_unlocked_${gateId}`, new Date().toISOString());
            } catch {
              /* private mode */
            }
            document.documentElement.classList.remove(lockClass);
            button.disabled = false;
            button.textContent = label;
            // Reveal happens in place: the form collapses and the first unlocked item takes its spot.
            document.querySelector<HTMLElement>(`[data-gated="${gateId}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
        });
      </script>
    </>
  )
}
