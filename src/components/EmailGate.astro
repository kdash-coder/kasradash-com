---
/*
 * EmailGate: an inline registration wall for one section of a page.
 *
 * HOW IT LOCKS
 *   Elements on the page marked `data-gated={gateId}` are the locked content.
 *   They are ALWAYS in the server-rendered HTML. Locking is a class on <html>
 *   (`gate-locked-{gateId}`) added by an inline script, and removed once the
 *   visitor submits their email (remembered in localStorage).
 *
 *   - No JavaScript (LLM crawlers, reader modes): nothing locks, full content.
 *   - Googlebot (renders JS): sees the wall, plus the `isAccessibleForFree`
 *     structured data the page adds, which is Google's sanctioned pattern for
 *     registration walls and is what stops this being treated as cloaking.
 *   - Humans: first gated element shows as a faded teaser, the rest are hidden.
 *
 * WHERE THE EMAIL GOES
 *   POSTed to CAPTURE_ENDPOINT (a GoHighLevel Inbound Webhook). See
 *   src/lib/capture.ts. While that is empty this component renders NOTHING and
 *   no content locks.
 *
 * WHAT IS SENT (form-encoded so it works cross-origin without CORS)
 *   Built by src/lib/capture-client.ts, shared with <EmailSignup />.
 *   email, first_name, source, tag, asset_name, asset_url, page_url, page_path, page_title,
 *   utm_source|medium|campaign|term|content   (last touch, else first touch)
 *   first_utm_source|medium|campaign, first_landing, first_referrer, first_seen
 *   fbclid|gclid, referrer, consent, submitted_at
 *
 *   `source` is the page slug. `tag` is "src:<slug>". The GoHighLevel workflow
 *   adds `tag` to the contact, so every lead shows which page it came from.
 */
import { CAPTURE_ENDPOINT, captureEnabled, sourceTag } from '../lib/capture';

interface Props {
  /** Unique per page. Matches the `data-gated` value on locked elements. */
  gateId: string;
  /** Page slug, becomes the GoHighLevel source + tag. */
  source: string;
  heading: string;
  blurb: string;
  button?: string;
  /** How many items are behind the wall, shown in the UI. */
  lockedCount?: number;
  /** What they are signing up to get. Becomes the first line of the universal welcome email. */
  assetName?: string;
  /** Link to it (absolute). Defaults to this page. */
  assetUrl?: string;
}

const { gateId, source, heading, blurb, button = 'Unlock the full list', lockedCount, assetName = '', assetUrl = '' } = Astro.props;
const tag = sourceTag(source);
---

{
  captureEnabled && (
    <>
      <script is:inline define:vars={{ gateId }}>
        try {
          if (!localStorage.getItem('kd_unlocked_' + gateId)) {
            document.documentElement.classList.add('gate-locked-' + gateId);
          }
        } catch (e) {
          document.documentElement.classList.add('gate-locked-' + gateId);
        }
      </script>

      <div
        id={`gate-${gateId}`}
        class="email-gate not-prose scroll-mt-28"
        data-gate={gateId}
        data-endpoint={CAPTURE_ENDPOINT}
        data-source={source}
        data-tag={tag}
        data-asset-name={assetName}
        data-asset-url={assetUrl}
      >
        <div class="rounded-[20px] border border-brand-500/40 bg-tint p-6 sm:p-8">
          <p class="font-display text-[0.7rem] font-bold uppercase tracking-wider text-brand-600">
            {lockedCount ? `${lockedCount} more factors below` : 'The rest of the list'}
          </p>
          <h3 class="mt-2 font-display text-xl font-bold leading-snug tracking-tight text-ink sm:text-2xl">{heading}</h3>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted sm:text-base">{blurb}</p>

          <form class="email-gate-form mt-6 grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_auto]" novalidate>
            <label class="sr-only" for={`gate-name-${gateId}`}>First name</label>
            <input
              id={`gate-name-${gateId}`}
              name="first_name"
              type="text"
              required
              autocomplete="given-name"
              placeholder="First name"
              maxlength="60"
              class="email-gate-input"
            />
            <label class="sr-only" for={`gate-email-${gateId}`}>Email address</label>
            <input
              id={`gate-email-${gateId}`}
              name="email"
              type="email"
              required
              autocomplete="email"
              inputmode="email"
              placeholder="you@company.com"
              maxlength="120"
              class="email-gate-input"
            />
            {/* Honeypot: real people never see or fill this. */}
            <div class="email-gate-hp" aria-hidden="true">
              <label>
                Company website
                <input name="company_website" type="text" tabindex="-1" autocomplete="off" />
              </label>
            </div>
            <button type="submit" class="btn-gradient inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-bold text-white">
              {button}
            </button>
          </form>

          <p class="email-gate-error mt-3 text-sm text-[#fca5a5]" role="alert" hidden></p>
          <p class="mt-4 text-xs leading-relaxed text-dim">
            You will get my SEO and AI search emails. Unsubscribe in one click. See the{' '}
            <a href="/privacy-policy/" class="underline hover:text-muted">privacy policy</a>.
          </p>
        </div>
      </div>

      <style is:global>
        .email-gate-input {
          width: 100%;
          border-radius: 9999px;
          border: 1px solid var(--color-tint-border);
          background: #000;
          color: var(--color-ink);
          padding: 0.75rem 1.1rem;
          font-size: 0.95rem;
        }
        .email-gate-input::placeholder {
          color: var(--color-dim);
        }
        .email-gate-input:focus {
          outline: 2px solid var(--color-brand-500);
          outline-offset: 1px;
        }
        .email-gate-hp {
          position: absolute;
          left: -9999px;
          width: 1px;
          height: 1px;
          overflow: hidden;
        }
        .email-gate {
          display: none;
        }
      </style>

      {/* Per-gate lock rules. Generated per gateId so several gates can coexist. */}
      <Fragment
        set:html={`<style>
html.gate-locked-${gateId} #gate-${gateId}{display:block;margin-top:2rem}
html.gate-locked-${gateId} [data-gated="${gateId}"]{display:none}
html.gate-locked-${gateId} [data-gated="${gateId}"][data-gate-teaser]{display:block;max-height:11rem;overflow:hidden;pointer-events:none;user-select:none;-webkit-mask-image:linear-gradient(#000 15%,transparent 95%);mask-image:linear-gradient(#000 15%,transparent 95%)}
</style>`}
      />

      <script>
        import { readForm, submitCapture } from '../lib/capture-client';

        document.querySelectorAll<HTMLElement>('.email-gate[data-gate]').forEach((gate) => {
          const gateId = gate.dataset.gate!;
          const lockClass = `gate-locked-${gateId}`;
          const form = gate.querySelector<HTMLFormElement>('form')!;
          const errorEl = gate.querySelector<HTMLElement>('.email-gate-error')!;
          const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
          const isLocked = () => document.documentElement.classList.contains(lockClass);

          // Any in-page link or chart row pointing at a locked item lands on the form instead.
          const redirectIfLocked = (id: string) => {
            if (!isLocked() || !id) return false;
            const target = document.getElementById(id);
            if (!target || target.dataset.gated !== gateId || target.hasAttribute('data-gate-teaser')) return false;
            // Scroll first, focus after: focusing an input cancels an in-flight smooth scroll.
            const y = gate.getBoundingClientRect().top + window.scrollY - Math.max(96, (window.innerHeight - gate.offsetHeight) / 2);
            window.scrollTo({ top: y, behavior: 'smooth' });
            window.setTimeout(() => form.querySelector<HTMLInputElement>('input[name="email"]')?.focus({ preventScroll: true }), 700);
            return true;
          };
          document.addEventListener(
            'click',
            (e) => {
              const el = (e.target as HTMLElement).closest<HTMLElement>('[data-target], a[href^="#"]');
              if (!el) return;
              const id = el.dataset.target ?? (el.getAttribute('href') ?? '').slice(1);
              if (redirectIfLocked(id)) {
                e.preventDefault();
                e.stopImmediatePropagation();
              }
            },
            true
          );
          if (location.hash) redirectIfLocked(location.hash.slice(1));

          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const values = readForm(form, errorEl);
            if (!values || values === 'bot') return;

            button.disabled = true;
            const label = button.textContent;
            button.textContent = 'Unlocking…';
            await submitCapture({
              endpoint: gate.dataset.endpoint!,
              email: values.email,
              firstName: values.firstName,
              source: gate.dataset.source ?? '',
              tag: gate.dataset.tag ?? '',
              assetName: gate.dataset.assetName ?? '',
              assetUrl: gate.dataset.assetUrl || location.origin + location.pathname,
            });
            try {
              localStorage.setItem(`kd_unlocked_${gateId}`, new Date().toISOString());
            } catch {
              /* private mode */
            }
            document.documentElement.classList.remove(lockClass);
            button.disabled = false;
            button.textContent = label;
            document.querySelector<HTMLElement>(`[data-gated="${gateId}"][data-gate-teaser]`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
        });
      </script>
    </>
  )
}
