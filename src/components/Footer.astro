---

<footer class="border-t border-tint-border bg-tint">
  <div class="mx-auto flex max-w-6xl flex-col items-center px-4 py-14 text-center sm:px-6">
    <a href="/" aria-label="Kasra Dash home">
      <img src="/images/Frame-106.png" alt="Kasra Dash" class="h-9 w-auto" width="170" height="36" loading="lazy" />
    </a>
    <p class="mt-5 max-w-xl text-sm leading-relaxed text-muted">
      Kasra Dash is an entrepreneur and SEO consultant based in Manchester, UK. Founder of The
      Masterminders Conference and creator of mySEO.app, sharing tested SEO strategies with
      business owners and SEOs.
    </p>
    <div class="mt-6 flex items-center gap-3">
      {socials.map((s) => (
        <a
          href={s.href}
          rel="noopener"
          target="_blank"
          aria-label={s.label}
          class="flex h-10 w-10 items-center justify-center rounded-full border border-tint-border text-lavender transition hover:border-brand-500 hover:bg-brand-500/15 hover:text-white"
        >
          <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
        </a>
      ))}
    </div>
    <a href="mailto:me@kasradash.com" class="mt-5 text-sm font-semibold text-lavender transition hover:text-white">me@kasradash.com</a>

    <div class="mt-10 flex w-full flex-col items-center justify-between gap-3 border-t border-tint-border pt-6 text-xs text-dim sm:flex-row">
      <p>© {year} Kasra Dash. All Rights Reserved.</p>
      <p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
        <a href="/about-kasra-dash/" class="transition hover:text-white">About</a>
        <span aria-hidden="true">·</span>
        <a href="/contact/" class="transition hover:text-white">Contact</a>
        <span aria-hidden="true">·</span>
        <a href="https://www.skool.com/the-new-search/about?utm_source=kasradash.com&utm_medium=site&utm_campaign=footer" target="_blank" rel="noopener" class="transition hover:text-white">The New Search</a>
        <span aria-hidden="true">·</span>
        <a href="/privacy-policy/" class="transition hover:text-white">Privacy Policy</a>
      </p>
    </div>
  </div>
</footer>
