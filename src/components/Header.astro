---
import { NAV, HUBS } from '../lib/site';
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-tint-border bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label="Kasra Dash home">
      <img src="/images/Group-89.png" alt="" class="h-9 w-auto" width="40" height="36" />
      <span class="font-display text-lg font-extrabold tracking-tight text-ink">Kasra Dash</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      <div class="group relative">
        <a
          href="/seo/"
          class={`flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-semibold hover:bg-tint hover:text-brand-600 ${current.startsWith('/seo') ? 'text-brand-600' : 'text-ink'}`}
        >
          SEO Guides
          <svg class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
        </a>
        <div class="invisible absolute left-1/2 top-full w-[560px] -translate-x-1/2 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100">
          <div class="grid grid-cols-2 gap-1 rounded-2xl border border-tint-border bg-white p-3 shadow-xl shadow-deep/10">
            {HUBS.map((hub) => (
              <a href={hub.url} class="rounded-xl p-3 hover:bg-tint">
                <span class="block font-display text-sm font-bold text-ink">{hub.name}</span>
                <span class="mt-0.5 block text-xs leading-snug text-muted">{hub.blurb}</span>
              </a>
            ))}
            <a href="/seo/" class="col-span-2 rounded-xl bg-tint p-3 text-center text-sm font-semibold text-brand-600 hover:bg-lavender/50">
              Browse the full SEO hub →
            </a>
          </div>
        </div>
      </div>
      {NAV.filter((n) => !n.children).map((item) => (
        <a
          href={item.href}
          class={`rounded-lg px-3 py-2 text-sm font-semibold hover:bg-tint hover:text-brand-600 ${current === item.href ? 'text-brand-600' : 'text-ink'}`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact/"
        class="brand-gradient hidden rounded-full px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-brand-500/30 transition hover:shadow-lg hover:shadow-brand-500/40 sm:inline-block"
      >
        Work With Me
      </a>
      <button
        id="mobile-menu-btn"
        class="rounded-lg p-2 text-ink hover:bg-tint lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-tint-border bg-white lg:hidden">
    <nav class="mx-auto max-w-6xl space-y-1 px-4 py-4" aria-label="Mobile">
      <a href="/seo/" class="block rounded-lg px-3 py-2 font-display font-bold text-ink hover:bg-tint">All SEO Guides</a>
      {HUBS.map((hub) => (
        <a href={hub.url} class="block rounded-lg px-3 py-2 pl-6 text-sm font-medium text-muted hover:bg-tint hover:text-ink">{hub.name}</a>
      ))}
      <a href="/about-kasra-dash/" class="block rounded-lg px-3 py-2 font-display font-bold text-ink hover:bg-tint">About</a>
      <a href="/free-ai-seo-sheet/" class="block rounded-lg px-3 py-2 font-display font-bold text-ink hover:bg-tint">Free AI SEO Sheet</a>
      <a href="/contact/" class="brand-gradient mt-2 block rounded-full px-5 py-3 text-center font-bold text-white">Work With Me</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
