---
import { SITE_URL, SITE_NAME } from '../lib/site';
import {
  buildGraph,
  personNode,
  websiteNode,
  webPageNode,
  breadcrumbNode,
  type Crumb,
  type PageType,
} from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  type?: 'website' | 'article';
  /** schema.org type of this page's WebPage node (ContactPage on /contact/, AboutPage on /about-kasra-dash/, …). */
  pageType?: PageType;
  /** Rendered as BreadcrumbList in the graph and linked from the WebPage node. */
  breadcrumbs?: Crumb[];
  /** Extra properties merged onto the WebPage node (mainEntity, about, hasPart, …). */
  webPageExtras?: Record<string, unknown>;
  /** Page-specific nodes appended to the single @graph (no @context of their own). */
  graphNodes?: object[];
  datePublished?: string;
  dateModified?: string;
  /** noindex:true → robots noindex,follow. Sitemap exclusion is wired in astro.config.mjs. */
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = '/images/Group-89.png',
  type = 'website',
  pageType = 'WebPage',
  breadcrumbs = [],
  webPageExtras = {},
  graphNodes = [],
  datePublished,
  dateModified,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const ogImageAbs = new URL(ogImage, SITE_URL).href;

// The page's single @graph: ONE #person + ONE #website sitewide, this page's WebPage
// node, its breadcrumb, then page-specific nodes (Article, …).
const graph = buildGraph([
  personNode(),
  websiteNode(),
  webPageNode({
    canonical,
    title,
    description,
    pageType,
    datePublished,
    dateModified,
    hasBreadcrumb: breadcrumbs.length > 0,
    extras: webPageExtras,
  }),
  ...(breadcrumbs.length > 0 ? [breadcrumbNode(canonical, breadcrumbs)] : []),
  ...graphNodes,
]);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:locale" content="en_GB" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />
<meta name="twitter:creator" content="@Kasra_Dash" />

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
