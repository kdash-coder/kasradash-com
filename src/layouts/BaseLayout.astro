---
import '../styles/global.css';
import '@fontsource-variable/albert-sans';
import '@fontsource-variable/plus-jakarta-sans';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Attribution from '../components/Attribution.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  type?: 'website' | 'article';
  pageType?: import('../lib/schema').PageType;
  breadcrumbs?: import('../lib/schema').Crumb[];
  webPageExtras?: Record<string, unknown>;
  graphNodes?: object[];
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean | 'nofollow';
}

const props = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/Group-89.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...props} />
    <Attribution />
    <!-- Google tag (gtag.js), GA4 property G-2P07S2XZ64 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-2P07S2XZ64"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-2P07S2XZ64');
    </script>
  </head>
  <body class="bg-black text-ink">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
