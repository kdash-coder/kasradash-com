---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TocScrollSpy from '../components/TocScrollSpy.astro';
import { SITE_URL, HUBS } from '../lib/site';
import { webPageId } from '../lib/schema';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  h1: string;
  path: string;
  siloName: string;
  guides: CollectionEntry<'articles'>[];
  headings?: Heading[];
  ogImage?: string;
  isPillar?: boolean;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
}

const { title, description, h1, path, siloName, guides, headings = [], ogImage, isPillar = false, datePublished, dateModified, noindex } = Astro.props;

// Consolidation folded thousands of words into some hubs (QA-REPORT-2): give any
// hub body with 4+ H2s the article ToC treatment; short intros stay rail-free.
// Fallback: some folds landed as one H2 over many H3s (link-building), so when
// H2s are sparse the rail builds from H3s instead.
const h2s = headings.filter((h) => h.depth === 2);
const h3s = headings.filter((h) => h.depth === 3);
const toc = h2s.length >= 4 ? h2s : h3s.length >= 4 ? h3s : h2s;
const showToc = toc.length >= 4;

const crumbs = isPillar
  ? [
      { label: 'Home', href: '/' },
      { label: 'SEO', href: '/seo/' },
    ]
  : [
      { label: 'Home', href: '/' },
      { label: 'SEO', href: '/seo/' },
      { label: siloName, href: path },
    ];

const otherHubs = HUBS.filter((hub) => hub.url !== path);

// The hub's WebPage node is typed CollectionPage; each child is referenced by the
// same #webpage id that child defines on its own page, keeping ids consistent sitewide.
const webPageExtras = {
  hasPart: guides.map((c) => {
    const childUrl = new URL(c.data.url, SITE_URL).href;
    return { '@type': 'WebPage', '@id': webPageId(childUrl), name: c.data.h1, url: childUrl };
  }),
};
---

<BaseLayout {title} {description} {path} {ogImage} pageType="CollectionPage" breadcrumbs={crumbs} {webPageExtras} {datePublished} {dateModified} {noindex}>
  <main>
    <div class="border-b border-tint-border bg-tint">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
        <Breadcrumbs {crumbs} />
        <h1 class="mt-4 max-w-4xl font-display text-3xl font-bold leading-tight tracking-tight text-ink sm:text-5xl">{h1}</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">{description}</p>
      </div>
    </div>

    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      {guides.length > 0 && (
        <section aria-label={`${siloName} guides`}>
          <h2 class="font-display text-2xl font-bold text-ink">
            {isPillar ? 'Explore the SEO topic hubs' : `All ${siloName} guides`}
          </h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {guides.map((c) => (
              <a
                href={c.data.url}
                class="group flex flex-col rounded-[20px] border border-tint-border bg-tint p-5 transition hover:-translate-y-0.5 hover:border-brand-500/50 hover:shadow-lg hover:shadow-brand-500/10"
              >
                <h3 class="font-display text-base font-bold leading-snug text-ink transition group-hover:text-brand-600">
                  {c.data.h1}
                </h3>
                <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{c.data.description}</p>
                <span class="mt-auto pt-3 text-sm font-bold text-brand-600">Read the guide →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <div class={showToc ? 'mt-14 gap-10 lg:grid lg:grid-cols-[12rem_minmax(0,1fr)]' : 'mt-14'}>
        {showToc && (
          <aside class="hidden lg:block">
            <nav class="sticky top-24" aria-label="On this page">
              <h2 class="font-display text-xs font-bold uppercase tracking-wider text-dim">On this page</h2>
              <ul class="mt-3 space-y-0.5 border-l border-tint-border">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="toc-link -ml-px block border-l-2 border-transparent py-1 pl-3 text-[0.8rem] leading-snug text-dim transition hover:border-brand-500/50 hover:text-ink"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
        <section class="reading-well prose prose-well max-w-3xl p-5 sm:p-8 lg:p-12">
          <slot />
        </section>
      </div>

      {!isPillar && (
        <section class="mt-14 rounded-[20px] border border-tint-border bg-tint p-6" aria-label="Other SEO topics">
          <h2 class="font-display text-lg font-bold text-ink">Keep exploring SEO</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {otherHubs.map((hub) => (
              <a href={hub.url} class="rounded-full border border-tint-border bg-deep px-4 py-2 text-sm font-semibold text-lavender transition hover:border-brand-500 hover:text-white">
                {hub.name}
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
  {showToc && <TocScrollSpy />}
</BaseLayout>
