---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TocScrollSpy from '../components/TocScrollSpy.astro';
import { SITE_URL } from '../lib/site';
import { articleNode } from '../lib/schema';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Related {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  h1: string;
  path: string;
  siloName: string;
  siloUrl: string;
  headings: Heading[];
  related: Related[];
  ogImage?: string;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
}

const { title, description, h1, path, siloName, siloUrl, headings, related, ogImage, datePublished, dateModified, noindex } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);

// Live byline format: "Last Updated August 3, 2026"
const lastUpdated = dateModified
  ? new Date(dateModified).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : undefined;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'SEO', href: '/seo/' },
  ...(siloUrl !== '/seo/' ? [{ label: siloName, href: siloUrl }] : []),
  { label: h1, href: path },
];

const canonical = new URL(path, SITE_URL).href;
const graphNodes = [
  articleNode({ canonical, headline: h1, description, image: ogImage, datePublished, dateModified }),
];
---

<BaseLayout {title} {description} {path} {ogImage} type="article" breadcrumbs={crumbs} {graphNodes} {datePublished} {dateModified} {noindex}>
  <main>
    <div class="border-b border-tint-border bg-tint">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
        <Breadcrumbs {crumbs} />
        <h1 class="mt-4 max-w-4xl font-display text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl lg:text-[2.75rem]">
          {h1}
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">{description}</p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <img src="/images/kasra-dash.jpg" alt="" class="h-10 w-10 rounded-full border border-tint-border object-cover" width="40" height="40" />
          <div class="text-sm">
            <p class="font-bold text-ink">
              Kasra Dash
              {lastUpdated && <span class="font-medium text-dim"> · Last Updated {lastUpdated}</span>}
            </p>
            <p class="text-dim">SEO Consultant · Founder, The Masterminders & mySEO.app</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-6xl gap-10 px-4 py-10 sm:px-6 lg:grid lg:grid-cols-[12rem_minmax(0,1fr)_14rem] lg:py-14">
      {/* Left: jump links */}
      <aside class="hidden lg:block">
        {toc.length > 2 && (
          <nav class="sticky top-24" aria-label="On this page">
            <h2 class="font-display text-xs font-bold uppercase tracking-wider text-dim">On this page</h2>
            <ul class="mt-3 space-y-0.5 border-l border-tint-border">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    class="toc-link -ml-px block border-l-2 border-transparent py-1 pl-3 text-[0.8rem] leading-snug text-dim transition hover:border-brand-500/50 hover:text-ink"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </aside>

      {/* Centre: article — light reading well on the dark frame */}
      <article class="reading-well prose prose-well max-w-none p-5 sm:p-8 lg:max-w-[46rem] lg:p-10">
        <slot />
      </article>

      {/* Right: sidebar — live pattern: related, newsletter, funnel CTA + contact links */}
      <aside class="mt-12 space-y-6 lg:mt-0">
        <div class="lg:sticky lg:top-24 space-y-6">
          <div class="rounded-[20px] border border-tint-border bg-tint p-5">
            <h2 class="font-display text-xs font-bold uppercase tracking-wider text-dim">Related guides</h2>
            <ul class="mt-3 space-y-2.5">
              {related.map((r) => (
                <li>
                  <a href={r.href} class="block text-sm font-semibold leading-snug text-lavender transition hover:text-white hover:underline">{r.title}</a>
                </li>
              ))}
              <li class="pt-1">
                <a href={siloUrl} class="text-sm font-bold text-brand-600 transition hover:text-white">All {siloName} guides →</a>
              </li>
            </ul>
          </div>

          <div class="rounded-[20px] bg-[linear-gradient(93.77deg,#845CFE_13.53%,#4A4EF8_88.57%)] p-px shadow-lg shadow-brand-500/20">
            <div class="rounded-[19px] bg-deep p-5">
              <h2 class="font-display text-lg font-bold leading-snug text-ink">The New Search</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted">
                Kasra's AI SEO community on Skool, with weekly live calls and his current test results.
              </p>
              <a
                href="https://www.skool.com/the-new-search/about?utm_source=kasradash.com&utm_medium=site&utm_campaign=article-sidebar"
                target="_blank"
                rel="noopener"
                class="btn-gradient mt-4 block px-4 py-2.5 text-center text-sm font-bold shadow-md shadow-brand-500/25 transition hover:shadow-lg hover:shadow-brand-500/40"
              >
                Join The New Search
              </a>
            </div>
          </div>

          <div class="rounded-[20px] border border-tint-border bg-tint p-5">
            <h2 class="font-display text-lg font-bold leading-snug text-ink">Want this done for you?</h2>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              Kasra Dash consults for brands that want rankings, not reports. Get a clear strategy built on tested SEO systems.
            </p>
            <a href="/contact/" class="mt-4 block rounded-full border border-tint-border px-4 py-2.5 text-center text-sm font-bold text-ink transition hover:border-brand-500 hover:bg-brand-500/10">
              Work With Me
            </a>
            <a href="mailto:me@kasradash.com" class="mt-3 block text-center text-xs font-semibold text-dim transition hover:text-white">
              me@kasradash.com
            </a>
          </div>
        </div>
      </aside>
    </div>
  </main>
  <TocScrollSpy />
</BaseLayout>
